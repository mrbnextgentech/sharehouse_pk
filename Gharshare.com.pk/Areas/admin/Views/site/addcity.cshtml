@using Gharshare.Models
@model City
@{
    ViewData["Title"] = "Add city";
    Layout = "_Layout4Popups";
}
<div class="col-lg-12">
    @if (Model.ID > 0)
    {
        <div class="row mb-2">
            <label class="text-label form-label">Featured Picture For City</label>
            <div id="imgCity">
                <img src="@Model.Image" style="height:200px;width:100%;border-radius:10px;"
                     onclick="document.getElementById('cityImage').click();" />
            </div>
            <input id="cityImage" type="file" style="display:none;"
                   onchange="validateUploadCityImage(this);" required asp-for="Image" name="cityImage" />
        </div>
    }
    <form id="frmCity" asp-area="admin" asp-action="addcity" method="Post" enctype="multipart/form-data">
        <input type="hidden" id="txtCityId" asp-for="ID" />
        <input type="hidden" asp-for="UId" />
        <input type="hidden" asp-for="CreatedOn" />
        <input type="hidden" asp-for="Image" />
        @Html.AntiForgeryToken()
        <div class="row justify-content-center mb-3">
            <label class="text-label form-label">
                City name
            </label>
            <div class="flex">
                <input type="text" asp-for="Name" id="txtCity"
                       class="form-control required placeholder="Enter city name..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row justify-content-center mb-3">
            <label class="text-label form-label">Short name</label>
            <div class="flex">
                <input id="txtCityShortName" type="text" asp-for="Shortname" maxlength="3"
                       class="form-control" required placeholder="Enter city short name..." />
                <span asp-validation-for="Shortname" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <label class="text-label form-label">Is this a featured city?</label>
                <div class="form-check custom-checkbox ms-1 ">
                    <input type="checkbox" value="true" asp-for="Featured"
                           class="form-check-input" />
                    <label class="form-check-label">
                        Yes! this is a featured city
                    </label>
                </div>
            </div>
        </div>
        @if (Model.ID <= 0)
        {
            <div class="row">
                <div class="col-sm-6">
                    <label class="text-label form-label">Featured Picture For City</label>
                    <input required type="file" asp-for="Image" name="cityImage" />
                </div>
            </div>
        }
        <div class="row justify-content-center mb-3">
            <div class="col-sm-6 text-end">
                @if (Model.ID > 0)
                {
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                }
            </div>
            <div class="col-sm-6">
                <a id="btnclose" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/site/saveCity.js"></script>
<script src="~/js/site/uploadCityImage.js"></script>
<script src="~/js/site/setCityshortName.js"></script>