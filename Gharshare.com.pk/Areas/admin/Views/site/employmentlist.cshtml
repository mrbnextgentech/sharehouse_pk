@using Gharshare.Models
@using Gharshare.CommonHelper
@model List<Employment>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Profession List";
}
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card m-5">
            <div class="card-header">
                <h4 class="card-title">Employment Status</h4>
            </div>
            <div class="card-body">
                <div class="row m-2">
                    <div class="col-md-12">
                        <a onclick="addEmployment()"
                           data-bs-toggle="modal" data-bs-target="#basicModal"
                           class="btn btn-primary">
                            <i class="fa fa-plus"></i>
                            Create New Empolyment
                        </a>
                    </div>
                </div>
                <hr />
                @if (Model.Any())
                {
                    <div class="row m-3">
                        @foreach (var employment in Model)
                        {
                            <div class="col-md-3 col-sm-6">                                
                                <div class="text-center mt-3">
                                    <label href="#" data-bs-toggle="modal" data-bs-target="#basicModal"
                                        onclick="addEmployment('@employment.ID');">
                                        <input type="hidden" asp-for="@employment.ID">
                                        <span class="radio-tile">
                                            <span class="radio-icon">
                                                <img src="@employment.IconPath">
                                            </span>
                                        </span>
                                    </label><p>@employment.Title</p>
                                </div>
                            </div>
                        }

                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/js/site/openAddemploymentview.js"></script>
