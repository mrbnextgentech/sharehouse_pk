@page "/login"
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
    Layout = null;
    TempData["error"] = HttpContext.Request.HttpContext.Items["Error"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="~/img/favicon.png" type="image/x-icon" />
    <link href="~/css/admin/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

</head>
<body>
    <partial name="_Notification" />
    <div class="vh-100">
        <div class="authincation h-100">
            <div class="container h-100">
                <div class="row justify-content-center h-100 align-items-center">
                    <div class="col-md-6">
                        <div class="authincation-content">
                            <div class="row no-gutters">
                                <div class="col-xl-12">
                                    @*<div class="mb-3 mt-5 m-2">
                                            <div id="loginErrorMessage" class="alert alert-danger alert-dismissible fade show" style="display:none;">
                                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                                <strong>Failed!</strong> Invalid login attempt.
                                                @*<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close">
                                                </button>
                                            </div>
                                        </div>*@
                                    <div class="auth-form">                                        
                                        <div class="text-center mb-3">
                                            <div>
                                                <a asp-area="" asp-controller="home" asp-action="index">
                                                    <img src="~/img/logo.png" style="height:60px;" alt="">
                                                </a>
                                            </div>
                                        </div>
                                        <h4 class="text-center mb-4">Login to your account</h4>
                                        @{
                                            if (Model.ExternalLogins.Count == 0)
                                            {
                                                        <div>No external logins configured</div>
                                            }
                                            else
                                            {
                                                for (int i = 0; i < @Model.ExternalLogins.Count(); i++)
                                                {
                                                    if (i == 0)
                                                    {
                                                                <div class="mb-3">
                                                                    <button class="google-button btn-block" type="button"
                                                                onclick="window.location.href='@Url.Page("ExternalLogin",new { provider = @Model.ExternalLogins[i].Name, returnUrl = @Model.ReturnUrl })'">
                                                                        <i class="fa fa-google"></i>
                                                                        Continue with @Model.ExternalLogins[i].DisplayName
                                                                    </button>
                                                                </div>
                                                    }
                                                    else if (i == 1)
                                                    {
                                                                <div class="mb-3">
                                                                    <button class="facebook-button btn-block" type="button"
                                                                onclick="window.location.href='@Url.Page("ExternalLogin",
                                                            new { provider = @Model.ExternalLogins[i].Name, returnUrl = @Model.ReturnUrl })'">
                                                                        <i class="fa fa-facebook"></i>
                                                                        Continue with @Model.ExternalLogins[i].DisplayName
                                                                    </button>
                                                                </div>
                                                    }
                                                }
                                            }
                                        }

                                        <form id="account" method="post">
                                            <div class="mb-3">
                                                <div class="input-group mb-3">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-user icon"></i>
                                                    </span>
                                                    <input type="text" data-val="true" data-val-required="*" class="form-control" placeholder="Please enter user name" asp-for="Input.Email" />
                                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="input-group mb-3">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-lock icon"></i>
                                                    </span>
                                                    <input type="password" asp-for="Input.Password" class="form-control" value="Password" placeholder="Please enter password">
                                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                                </div>
                                                <span id="loginErrorMessage" style="display:none;" class="text-danger"></span>
                                            </div>
                                            <div class="row d-flex justify-content-between mt-4 mb-2">
                                                <div class="mb-3">
                                                    <div class="form-check custom-checkbox ms-1">
                                                        <input type="checkbox" asp-for="Input.RememberMe" class="form-check-input" id="basic_checkbox_1">
                                                        <label asp-for="Input.RememberMe" class="form-check-label" for="basic_checkbox_1">Remember Me</label>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot Password?</a>
                                                </div>
                                            </div>
                                            <div class="text-center">
                                                <button type="submit" id="login-submit" class="btn btn-primary btn-block">Sign Me In</button>
                                            </div>
                                        </form>
                                        <div class="new-account mt-3">
                                            <p>Don't have an account? <a class="text-primary" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a></p>
                                        </div>
                                        <div class="new-account mt-3">
                                            <p>
                                                Want to get email confirmation? <a class="text-primary" id="resend-confirmation"
                                                                                   asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>     
    <partial name="_ValidationScriptsPartial" />
    <script>
    var failedLogin = @(((bool?)ViewData["FailedLogin"] ?? false).ToString().ToLower());
    if (failedLogin) {
        var loginErrorMessage = document.getElementById("loginErrorMessage");
        loginErrorMessage.style.display = "block";
        loginErrorMessage.innerText = "Invalid user name or password";
        // Add the following JavaScript code to dismiss the alert after 3 seconds
        setTimeout(function() {
            loginErrorMessage.style.display = "none";
        }, 3000);
    }
</script>

</body>
</html>
