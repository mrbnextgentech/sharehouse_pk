@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    //ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "_Layout4Popups";
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="row justify-content-center h-100 align-items-center">
    <div class="col-md-12">
        <div class="authincation-content">
            <div class="row no-gutters">
                <div class="col-xl-12">
                    <div class="auth-form">
                        <h4 class="text-center mb-2">
                            @ViewData["Title"]
                        </h4>                         
                        <form id="change-password-form" method="post">
                            <div class="mb-3">
                                <label><strong>Current password</strong></label>
                                <div class="form-inline">
                                    <input id="txtOldpassword" asp-for="Input.OldPassword" 
                                    class="form-control" autocomplete="current-password" aria-required="true" />
                                   <span id="spanOldpassword" 
                                       asp-validation-for="Input.OldPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label><strong>New password</strong></label>
                                <div class="form-inline">
                                    <input id="txtNewpassword" asp-for="Input.NewPassword" 
                                    class="form-control" autocomplete="new-password" aria-required="true" />
                                   <span id="spanNewpassword" 
                                       asp-validation-for="Input.NewPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label><strong>Confirm password</strong></label>
                                <div class="form-inline">
                                     <input id="txtConfirmpassword" asp-for="Input.ConfirmPassword" 
                                     class="form-control" autocomplete="new-password" aria-required="true" />
                                   <span id="spanConfirmpassword" 
                                       asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <button type="submit" onclick="postbackChangepasswordPage()"
                                    class="btn btn-primary btn-block">
                                    Update password
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/js/profile/postbackChangepasswordPage.js"></script>
