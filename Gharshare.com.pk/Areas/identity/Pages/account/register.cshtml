@page "/register"
@model RegisterModel
@using Gharshare.CommonHelper
@using Gharshare.Models
@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="shortcut icon" href="~/img/favicon.png" type="image/x-icon" />
    <title>@ViewData["Title"] - sharehouse.pk</title>
    <link href="~/css/admin/style.css" rel="stylesheet">
    <!-- Place favicon.png in the root directory -->
    <link rel="shortcut icon" href="~/img/favicon.png" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    @*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css" integrity="sha512-SzlrxWUlpfuzQ+pcUCosxcglQRNAq/DZjVsC0lE40xsADsfeQoEypE+enwcOiGjk/bSuGGKHEyjSoQ1zVisanQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />*@

</head>
<body class="vh-100">
    <div class="authincation mt-50 mb-50">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-6">
                    <div class="authincation-content mt-5 mb-5">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-3">
                                        <a asp-area="" asp-controller="home" asp-action="index">
                                            <img height="60px" src="~/img/logo.png" alt="">
                                        </a>
                                    </div>
                                    @if (!User.IsInRole(WebSiteRoles.Role_Admin))
                                    {
                                        <h4 class="text-center mb-4">
                                            Register Now to Find or create Listings
                                        </h4>
                                    }
                                    else
                                    {
                                        <h3 class="text-center mb-4">
                                            Fill in Form to Create User
                                        </h3>
                                    }
                                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <input type="radio" name="ltype" id="registerbyemail" checked value="email" />
                                                <label>Sign up using email id</label>
                                            </div>
                                            <div class="col-md-6">
                                                <input type="radio" name="ltype" id="registerbymobile" value="phone" />
                                                <label>Sign up using mobile phone</label>
                                            </div>
                                        </div>
                                        @if (User.IsInRole(WebSiteRoles.Role_Admin))
                                        {
                                            <div class="input-group mb-3">
                                                <span class="input-group-text">
                                                    <i class="fas fa-user-tie icon"></i>
                                                </span>
                                                <select asp-for="Input.UserType" data-val="true" data-val-required="*" class="form-control">
                                                    <option selected="selected" value="">--select user role--</option>
                                                    <option value="Admin">Admin</option>
                                                    <option value="User">User</option>
                                                </select>
                                                <span asp-validation-for="Input.UserType" class="text-danger"></span>
                                            </div>
                                        }
                                        else
                                        {
                                            @*<input type="hidden" asp-for="Input.UserType" value="User">*@
                                            <input type="hidden" asp-for="Input.UserType" value=@ApplicationUser.usertype.freeuser>

                                            if (Model.ExternalLogins.Count == 0)
                                            {
                                                <div>No external logins configured</div>
                                            }
                                            else
                                            {
                                                for (int i = 0; i < @Model.ExternalLogins.Count(); i++)
                                                {
                                                    if (i == 0)
                                                    {
                                                        <div class="mb-3">
                                                            <button class="google-button btn-block" type="button"
                                                                    onclick="window.location.href='@Url.Page("ExternalLogin",new { provider = @Model.ExternalLogins[i].Name, returnUrl = @Model.ReturnUrl })'">
                                                                <i class="fa fa-google"></i>
                                                                Continue with @Model.ExternalLogins[i].DisplayName
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (i == 1)
                                                    {
                                                        <div class="mb-3">
                                                            <button class="facebook-button btn-block" type="button"
                                                                    onclick="window.location.href='@Url.Page("ExternalLogin",
                                                            new { provider = @Model.ExternalLogins[i].Name, returnUrl = @Model.ReturnUrl })'">
                                                                <i class="fa fa-facebook"></i>
                                                                Continue with @Model.ExternalLogins[i].DisplayName
                                                            </button>
                                                        </div>
                                                    }
                                                }
                                            }
                                        }
                                        @*<div class="col-md-12 text-center">---------------------or---------------------</div>*@
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-user icon"></i>
                                            </span>
                                            <input asp-for="Input.Name" data-val="true" data-val-required="*" class="form-control" data autocomplete="Name" placeholder="full name" aria-required="true" />
                                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                                        </div>
                                        @*<div class="input-group mb-3">
                                        <span class="input-group-text">
                                        <i class="fa fa-id-card icon"></i>
                                        </span>
                                        <input id="cnic" name="cnic" maxlength="15" asp-for="Input.CNIC" oninput="formatCnic(this)" maxlength="15" class="form-control" data-val="true" data-val-required="*" placeholder="cnic">
                                        <span asp-validation-for="Input.CNIC" class="text-danger"></span>
                                        </div>*@
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fas fa-genderless icon"></i>
                                            </span>
                                            <select asp-for="Input.Gender" data-val="true" data-val-required="*" class="form-control">
                                                <option selected="selected" value="">--select gender--</option>
                                                <option value="1">Male</option>
                                                <option value="2">Female</option>
                                                <option value="3">Transgender</option>
                                                <option value="4">Undisclosed</option>
                                                @*<option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Transgender">Transgender</option>
                                                <option value="Undisclosed">Undisclosed</option>*@
                                            </select>
                                            <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                        </div>
                                        <div id="divSignUpByMobile" class="input-group mb-3 d-none">
                                            <span class="input-group-text">
                                                <i class="fa fa-phone"></i>
                                            </span>
                                            <input asp-for="Input.Mobile" id="txtmobile" type="text" maxlength="11" pattern="[0-9]{1,10}"
                                                   inputmode="numeric" class="form-control" data-val-required="*"
                                                   placeholder="enter mobile number" aria-required="true" />
                                            <span id="spanMobile" asp-validation-for="Input.Mobile" class="text-danger"></span>
                                        </div>
                                        <div id="divSignUpByEmail" class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-envelope icon"></i>
                                            </span>
                                            <input asp-for="Input.Email" id="txtusername" data-val="true" data-val-required="*" class="form-control"
                                                   placeholder="hello@example.com" aria-required="true" />
                                            <span id="spanEmail" asp-validation-for="Input.Email" class="text-danger"></span>
                                        </div>
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-lock icon"></i>
                                            </span>
                                            <input id="txtPassword" type="password" asp-for="Input.Password" data-val="true" data-val-required="*" class="form-control" placeholder="password" aria-required="true" />
                                            <small>
                                                Password must be at least 6 digit long and contain one
                                                capital & one small alphabet.
                                            </small>
                                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                                        </div>
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-shield icon"></i>
                                            </span>
                                            <input type="password" asp-for="Input.ConfirmPassword" data-val="true" data-val-required="*" class="form-control" placeholder="confirm password" aria-required="true" />
                                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                        </div>
                                        @*<div class="g-recaptcha" data-sitekey="6LeH4xgmAAAAAM8l9lUYWCc8QsFC04JY9qnlAZ9n"></div>*@
                                        <div id="divcaptcha"></div>
                                        <input type="hidden" id="txtcaptcha" required />
                                        @if (!User.IsInRole(WebSiteRoles.Role_Admin))
                                        {
                                            <div class="row d-flex justify-content-between mt-4 mb-2">
                                                <div class="mb-3">
                                                    <div class="form-check custom-checkbox ms-1">
                                                        <input id="chkTerms" type="checkbox" asp-for="Input.AgreedtoTerms"
                                                               class="form-check-input" id="basic_checkbox_1">
                                                        <label class="form-check-label" for="basic_checkbox_1">
                                                            By clicking Create Account, you agree to our sharehousepk
                                                            <a class="text-primary" href="#">terms & conditions</a>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-center mt-4">
                                                <button id="registerSubmit" disabled type="submit" class="btn btn-primary btn-block">
                                                    Create Account
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <input style="visibility: hidden;" id="chkTerms" type="checkbox"
                                                       asp-for="Input.AgreedtoTerms" class="form-check-input">
                                            </div>
                                            <div class="text-center mt-4">
                                                <button id="registerSubmit" type="submit" class="btn btn-primary btn-block">
                                                    Create User
                                                </button>
                                            </div>
                                        }

                                    </form>
                                    <div class="new-account mt-3">
                                        <p>Already have an account? <a class="text-primary" id="login" asp-area="identity" asp-page="/account/login">Sign in</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--**********************************
        Scripts
    ***********************************-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.js"></script>
    <script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async defer>
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.32/dist/sweetalert2.all.min.js"></script>

    <script type="text/javascript">
        var onloadCallback = function () {
            grecaptcha.render('divcaptcha', {
                'sitekey': '6LeH4xgmAAAAAM8l9lUYWCc8QsFC04JY9qnlAZ9n',
                'callback': function (response) {
                    $('#txtcaptcha').val(response); // Set the response value in the hidden input field
                }
            });
        };

        // Add client-side validation to prevent form submission if reCAPTCHA is unchecked
        $(document).ready(function () {
            $('#registerForm').submit(function (e) {
                var response = $('#txtcaptcha').val();
                if (!response) {
                    e.preventDefault(); // Prevent form submission
                    //  alert('Please verify that you are not a robot.'); // Display an error message
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: "Please check 'I'm not a robot' to verify that you are a human",
                        showConfirmButton: false,
                        timer: 3000,
                    });
                }
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/PopulateDropdownList.js" type="text/javascript"></script>
    <script src="~/js/enableRegistration.js" type="text/javascript"></script>
    <partial name="_GoogleAutocompAddPartial" />
    <!-- Required vendors -->
    <script src="./vendor/global/global.min.js"></script>
    <script src="./js/custom.min.js"></script>
    <script src="./js/deznav-init.js"></script>
    <script src="~/js/formatcnic.js"></script>
    <script src="~/js/formatmobilenum.js"></script>
    <script src="~/js/register/checkUsername.js"></script>
    <script src="~/js/register/checkCellNumberAsUsernameExist.js"></script>
    <script src="~/js/register/toggleSignUpMethod.js"></script>
    <script src="/js/profile/validatePassword.js"></script>
</body>
</html>