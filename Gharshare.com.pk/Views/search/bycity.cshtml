}
<section class="banner" style="background-image: url('@(!string.IsNullOrEmpty(Model.cityImage) ? Model.cityImage : "/img/default-city-image.png")');">
    <div class="container-fluid">
        <div class="row">
            <div class="col">
                <div class="container">
                    <div class="list">
                        <ul class="d-flex list-unstyled text-white align-items-center mt-2">
                            <li class="mt-0">
                                <a href="##" style="color:gray;">
                                    Home <span class="fw-bold align-items-center">
                                    <i class="fa-solid fa-angle-right"></i></span></a>
                            </li>
                            <li class="mt-0"><a style="color:gray;" href="##">@Model.city</a></li>
                        </ul>
                    </div>
                </div>

