                                                    <i class="fa fa-bed" style="color: #5c727d;"> <span>@placelisting.Bed</span></i>
                                                    <i class="fa fa-user" style="color: #5c727d;"> <span>@placelisting.Totalflatmates</span></i>

                                                    @*</li>
                                        </ul>*@
                                                </div>
                                                <div class="col-md-7">
                                                    <ul>
                                                        <li>
                                                            @if (placelisting.Accommodationtype == @Property.AccType.WholeProperty)
                                                            {
                                                                <p>@Utility.GetEnumDisplayName(placelisting.Accommodationtype)</p>
                                                            }
                                                            else
                                                            {
                                                                <p>@placelisting.RoomsForRent @Utility.GetEnumDisplayName(placelisting.Accommodationtype)</p>
                                                            }
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <p>
                                            <a asp-action="listplacedetail" asp-controller="home"
                                   asp-route-listingid="@placelisting.UId">
                                                @if (!string.IsNullOrEmpty(placelisting.Description) && placelisting.Description.Length >= 30)
                                                {
                                                    <p>@placelisting.Description.Substring(0, 30)....</p>
                                                }
                                                else
                                                {
                                                    <p>@placelisting.Description</p>
                                                }
                                            </a>
                                        </p>
                                        @if (placelisting.Accommodationtype == @Property.AccType.WholeProperty)
                                        {
                                            @if (placelisting.AvailableFrom <= DateTime.UtcNow)
                                            {
                                                <div class="ltn__blog-btn">
                                                    Available Now
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ltn__blog-btn">
                                                    Available from
                                                    @Utility.ConvertToShortDateFormat(placelisting.AvailableFrom)
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            if (@placelisting.Rooms.Any())
                                            {

                                                @if (@placelisting.Rooms[0].AvailableFrom <= DateTime.UtcNow)
                                                {
                                                    <div class="ltn__blog-btn">
                                                        Available now
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="ltn__blog-btn">
                                                        Available from
                                                        @Utility.ConvertToShortDateFormat(@placelisting.Rooms[0].AvailableFrom)
                                                    </div>
                                                }
                                            }
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
