<script>
    function toggleView() {
        var btn = $('#btnShowmap');
        if (btn.text() === "Show Map") {
            $('#listingRow').hide()
            $('#mapRow').show()
            btn.text("Show Listings");
        } else {
            $('#listingRow').show()
            $('#mapRow').hide()
            btn.text("Show Map");
        }
    }
    $(document).ready(function () {

        $('.slider').slick({
            slidesToShow: 6,
            slidesToScroll: 1,
            arrows: true,
            infinite: false,
            responsive: [

                {
                    breakpoint: 1100,
                    settings: {
                        arrows: true,
                        centerMode: true,
                        centerPadding: '40px',
                        slidesToShow: 4
                    }
                },
                {
                    breakpoint: 991,
                    settings: {
                        arrows: true,
                        centerMode: true,
                        centerPadding: '40px',
                        slidesToShow: 3
                    }
                },
                {
                    breakpoint: 768,
                    settings: {
                        arrows: true,
                        centerMode: true,
                        centerPadding: '40px',
                        slidesToShow: 2
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        arrows: true,
                        centerMode: true,
                        centerPadding: '40px',
                        slidesToShow: 1
                    }
                }
            ]
        });
    })
</script>