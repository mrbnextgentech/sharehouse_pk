@using Gharshare.CommonHelper
@using Gharshare.Models
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model SearchVM
@{
    ViewData["Title"] = "Listings |";
    Layout = "_Layoutmain";
    var session = HttpContextAccessor.HttpContext.Session;
}

<!-- LISTING AREA START -->
<div class="ltn__blog-area ltn__blog-item-3-normal mt-5 mb-100">
    <div class="container">
        <div class="row">
            <form id="frmSearch" asp-action="index" asp-controller="search">
                <input type="hidden" id="txtsearchtype" name="txtsearchtype" value="@Model.Searchtype" />
                <input type="hidden" id="txthiddenaddress" name="address" value="@Model.address" />
                <input type="hidden" id="filter" name="filter" />
            </form>
        </div>
        <div class="row">
            <div class="col-md-8">
                <h3>Search results</h3>
            </div>
            <div class="col-md-4">
                <select id="ddlfilter" class="nice-select w-100" asp-for="@Model.filter">
                    <option value="" selected>--select a filter--</option>
                    <option value="newst">Newst listings</option>
                    <option value="rentl2h">Rent(low to hight)</option>
                    <option value="renth2l">Rent(hight to low)</option>
                    <option value="earliestava">Earliest available</option>
                    @*<option>Recently active</option>*@
                </select>
            </div>
        </div><hr />
        @if (Model.Searchtype == "flatmates" || Model.Searchtype == "teamups")
        {
            @if (!(Model.PersonListings.Any()))
            {
                <div class="row text-center">
                    <p>No record found</p>
                </div>
            }
        }
        else
        {
            @if (!(Model.Propertylistings.Any()))
            {
                <div class="row text-center">
                    <p>No record found</p>
                </div>
            }
        }
        @{
            string address = string.Empty;
            if (@Model.Propertylistings!=null)
            {
                <div class="row mb-2">
                    <div class="col-md-4">
                        <a id="btnShowmap" class="theme-btn-1a btn-2a btn btn-effect-1 m-auto" onclick="toggleView()">Show Map</a>
                    </div>
                </div>
            }
        }
        <div class="row" id="listingRow">
            <!-- Person Listing Item -->
            @if (Model.Searchtype == "flatmates" || Model.Searchtype == "teamups")
            {
                if (Model.PersonListings.Count() > 0)
                {
                    foreach (var personListing in Model.PersonListings)
                    {
                        <div class="col-lg-4 col-sm-6 col-12">
                            <div class="ltn__List-item ltn__blog-item-3">
                                <div class="ltn__blog-img">
                                    <a asp-action="persondetails" asp-controller="home"
                           asp-route-listingId="@personListing.UId">
                                        <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel"
                                 data-interval="false">
                                            <ol class="carousel-indicators">
                                                <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active">
                                                </li>
                                                <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                                                <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                                            </ol>
                                            <div class="carousel-inner">
                                                <div class="carousel-item active">
                                                    <img src="@(personListing.User.ProfilePicture ?? "/img/default-user.jpg")" class="d-block w-100" alt="..." style="min-height:360px;">
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                    @if (session.GetString("_UserId") != null && session.GetString("_UserId") != "")
                                    {
                                        <a class="shortlistButton"
                           onclick="shortlistPerson('@personListing.ID','@session.GetString("_UserId")')">
                                            <i class="fa-regular fa-star fa-xl"
                               style="color: #ffffff;"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="shortlistButton"
                           asp-area="Identity" asp-page="/Account/Login">
                                            <i class="fa-regular fa-star fa-xl"
                               style="color: #ffffff;"></i>
                                        </a>
                                    }
                                    @if (personListing.User.FreetoMessage)
                                    {
                                        <div class="sendMessage">
                                            <span>Free to Message</span>
                                        </div>
                                    }
                                </div>

                                <div class="ltn__blog-brief">
                                    <div class="ltn__blog-meta">
                                        <ul>
                                            <li class="ltn__blog-author">
                                                <h6>@personListing.User.Name</h6>
                                            </li>
                                        </ul>
                                        <ul>
                                            <li>
                                                <p>
                                                    <span>Rs.</span>@Utility.Format(@personListing.MonthlyBudget)/month
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    <span> • </span>@personListing.User.Age year old
                                                    @Utility.GetEnumDisplayName(@personListing.User.Gender)
                                                </p>
                                            </li>
                                        </ul>
                                        <p>
                                            <a asp-action="findplacepreview" asp-controller="findplace" asp-route-listingId=@personListing.UId>
                                                @if (!string.IsNullOrEmpty(personListing.Introduction) && personListing.Introduction.Length >= 30)
                                                {
                                                    <p>@personListing.Introduction.Substring(0, 30)....</p>
                                                }
                                                else
                                                {
                                                    @personListing.Introduction
                                                }
                                            </a>
                                        </p>
                                        @if (personListing.MoveDate <= DateTime.UtcNow)
                                        {
                                            <div class="ltn__blog-btn">
                                                Available Now
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ltn__blog-btn">
                                                Available From @Utility.ConvertToShortDateFormat(personListing.MoveDate)
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else if (Model.Searchtype == "rooms")
            {
                if (@Model.Propertylistings.Any())
                {
                    @*string address = string.Empty;*@
                    foreach (var placelisting in @Model.Propertylistings)
                    {
                        var listingId = placelisting.UId;
                        if (address == string.Empty)
                            address = Utility.RemoveStreetHouse(placelisting.Address);
                        else
                            address = address + "&" + Utility.RemoveStreetHouse(placelisting.Address);
                        if (@placelisting.Accommodationtype == @Property.AccType.WholeProperty)
                        {
                            address = address + ":" + @Utility.Format(placelisting.Rent);
                        }
                        else
                        {
                            if (placelisting.Rooms.Any())
                            {
                                var minRoomRent = @Utility.Format(placelisting.Rooms.Min(room => room.Rent));
                                var maxRoomRent = @Utility.Format(placelisting.Rooms.Max(room => room.Rent));
                                if (minRoomRent == maxRoomRent)
                                {
                                    address = address + ":" + minRoomRent;
                                }
                                else
                                {
                                    address = address + ":" + minRoomRent + "-" + maxRoomRent;
                                }
                            }
                        }
                        <div class="col-lg-4 col-sm-6 col-12">
                                <div class="ltn__blog-item ltn__blog-item-3">
                                    <div class="ltn__blog-img">
                                        @if (listingId != null)
                                        {
                                            <a href="@Url.Action("listplacedetail", "home", new { listingid = listingId })">
                                                <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel"
                                 data-interval="false">
                                                    <ol class="carousel-indicators">
                                                        <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active">
                                                        </li>
                                                        <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                                                        <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                                                    </ol>
                                                    <div class="carousel-inner">
                                                        <div class="carousel-item active">
                                                            <img src="@placelisting.CoverImage" class="d-block w-100" alt="..." style="min-height:360px;">
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (session.GetString("_UserId") != null && session.GetString("_UserId") != "")
                                                {
                                                    <a class="shortlistButton"
                               onclick="shortPlacelisting('@placelisting.ID','@session.GetString("_UserId")')">
                                                        <i class="fa-regular fa-star fa-xl"
                                   style="color: #ffffff;"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="shortlistButton"
                               asp-area="Identity" asp-page="/Account/Login">
                                                        <i class="fa-regular fa-star fa-xl"
                                   style="color: #ffffff;"></i>
                                                    </a>
                                                }
                                            </a>
                                        }
                                        @if (@placelisting.Owner.FreetoMessage)
                                        {
                                            <div class="sendMessage">
                                                <span>Free to Message</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="ltn__blog-brief">
                                        <div class="ltn__blog-meta">
                                            <ul>
                                                @if (@placelisting.Accommodationtype == @Property.AccType.WholeProperty)
                                                {
                                                    <li class="ltn__blog-author">
                                                        <h6><span>Rs.</span> @Utility.Format(placelisting.Rent)/month</h6>
                                                    </li>
                                                }
                                                else
                                                {
                                                    if (placelisting.Rooms.Any())
                                                    {
                                                        var minRent = @Utility.Format(placelisting.Rooms.Min(room => room.Rent));
                                                        var maxRent = @Utility.Format(placelisting.Rooms.Max(room => room.Rent));

                                                        <li class="ltn__blog-author">
                                                            @if (minRent == maxRent)
                                                            {
                                                                <h6><span>Rs.</span>@minRent/month</h6>
                                                            }
                                                            else
                                                            {
                                                                <h6><span>Rs.</span>@minRent-@maxRent/month</h6>
                                                            }
                                                        </li>
                                                    }
                                                }
                                            </ul>
                                            <div class="ltn__blog-meta">
                                                <ul>
                                                    <li>
                                                        <i class="fa-solid fa-bath" style="color: #5c727d;"> <span>@placelisting.Bathroom</span></i>
                                                        <i class="fa-solid fa-bed" style="color: #5c727d;"> <span>@placelisting.Bed</span></i>
                                                        <i class="fa-solid fa-user" style="color: #5c727d;"> <span>@placelisting.Totalflatmates</span></i>

                                                    </li>
                                                    <li>
                                                        @if (placelisting.Accommodationtype == @Property.AccType.WholeProperty)
                                                        {
                                                            <p>@Utility.GetEnumDisplayName(placelisting.Accommodationtype)</p>
                                                        }
                                                        else
                                                        {
                                                            <p>@placelisting.RoomsForRent @Utility.GetEnumDisplayName(placelisting.Accommodationtype)</p>
                                                        }
                                                    </li>
                                                </ul>
                                            </div>
                                            <p>
                                                <a asp-action="listplacedetail" asp-controller="home"
                                   asp-route-listingid="@placelisting.UId">
                                                    @if (!string.IsNullOrEmpty(placelisting.Description) && placelisting.Description.Length >= 30)
                                                    {
                                                        <p>@placelisting.Description.Substring(0, 30)....</p>
                                                    }
                                                    else
                                                    {
                                                        <p>@placelisting.Description</p>
                                                    }
                                                </a>
                                            </p>
                                            @if (placelisting.Accommodationtype == @Property.AccType.WholeProperty)
                                            {
                                                <div class="ltn__blog-btn">
                                                    @if (placelisting.AvailableFrom <= DateTime.UtcNow)
                                                    {
                                                        <span>Available Now </span>
                                                    }
                                                    else
                                                    {
                                                        <span>Available from </span>
                                                        @Utility.ConvertToShortDateFormat(placelisting.AvailableFrom)
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                if (@placelisting.Rooms.Any())
                                                {
                                                    <div class="ltn__blog-btn">
                                                        @if (@placelisting.Rooms[0].AvailableFrom <= DateTime.UtcNow)
                                                        {
                                                            <span>Available now</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Available from </span>
                                                            @Utility.ConvertToShortDateFormat(@placelisting.Rooms[0].AvailableFrom)
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <div id="mapRow" class="mt-3" style="display:none;">
                <h4>Property Map</h4>
                <input id="txtAddresslist" type="hidden" value="@address">
                <div class="col-lg-12" id="map" style="height: 500px;">
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/search/filterSearchresults.js"></script>
    <script src="~/js/shortlist/shortlistPlace.js"></script>
    <script src="~/js/shortlist/shortlistPerson.js"></script>
    <script src="~/js/commonfunctions/showPropertiesOnGooglemap.js"></script>
    <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAyQhihensPLJP3qiNAT0_b-SbtD1jbrOs&callback=initMap&libraries=&v=weekly" defer"></script>
    <script src="~/js/search/toggleView.js"></script>

