                            @if (Model.Property.VideoURL != null)
                            {
                                <h4>Video Tour</h4>
                                <div class="mb-3" style="width:100%; height:300px;">
                                    @{
                                        string videoId = Model.Property.VideoURL;
                                        string embeddedUrl = $"https://www.youtube.com/embed/{videoId}";
                                    }
                                    <iframe title="video-tour" src="@embeddedUrl" style="width:100%; height:300px;"
