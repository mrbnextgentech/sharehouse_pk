@{
    Layout = "_Layoutmain";
}

<div class="col-lg-12">
    <div class="card m-5">
        <div class="card-header">
            <h4 class="card-title">OTP Send Test</h4>
        </div>
        <div class="card-body">
            <form>
                <h3>Enter phone no</h3>
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" id="number" placeholder="Enter mobile number...">
                        <button id="sendOTP" type="button" value="Submit">Send Code</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="row mt-3" id="recaptcha-container"></div>
        <div class="row mt-3">
            <form>
                <h3>Enter OTP</h3>
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" id="otpInput" value="enter OTP">
                        <button type="button" id="btnVerify" value="Submit">Verify Mobile number</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="module" src="~/js/commonfunctions/testFirebase.js"></script>