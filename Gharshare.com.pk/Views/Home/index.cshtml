<!-- LISTING AREA START -->
<div class="ltn__blog-area ltn__blog-item-3-normal mt-5 mb-100">
    <div class="container">
        <div class="row">
            @if (session.GetString("_UserType") == "landlord")
            {
                <!-- Person Listing Item -->
                @if (Model.PersonListings.Any())
                {
                    foreach (var personListing in Model.PersonListings)
                    {
                        <div class="col-lg-4 col-sm-6 col-12">
                            <div class="ltn__List-item ltn__blog-item-3">
                                <div class="ltn__blog-img">
                                    <a asp-action="persondetails" asp-controller="home"
                                       asp-route-listingId="@personListing.UId">
                                        <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel"
                                             data-interval="false">
                                            <ol class="carousel-indicators">
                                                <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active">
                                                </li>
                                                <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                                                <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                                            </ol>
                                            <div class="carousel-inner">
                                                <div class="carousel-item active">
                                                    <img src="@(personListing.User.ProfilePicture??"/img/default-user.jpg")" class="d-block w-100" alt="..." style="min-height:360px;">
                                                </div>
                                            </div>
                                        </div>
                                    </a>

                                    @if (session.GetString("_UserId") != null && session.GetString("_UserId") != "")
                                    {
                                        <a class="shortlistButton"
                                           onclick="shortlistPerson('@personListing.ID','@session.GetString("_UserId")')">
                                            <i class="fa-regular fa-star fa-xl"
                                               style="color: #ffffff;"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="shortlistButton"
                                           asp-area="Identity" asp-page="/Account/Login">
                                            <i class="fa-regular fa-star fa-xl"
                                               style="color: #ffffff;"></i>
                                        </a>
                                    }

                                    @if (personListing.User.FreetoMessage)
                                    {
                                        <div class="sendMessage">
                                            <span>Free to Message</span>
                                        </div>
                                    }
                                </div>
                                <div class="ltn__blog-brief">
                                    <div class="ltn__blog-meta">
                                        <ul>
                                            <li class="ltn__blog-author">
                                                <h6>@personListing.User.Name</h6>
                                            </li>
                                            @*@if (personListing.User.FreetoMessage)
                                {
                                <li class="ltn__blog-btn float-end">
                                <a href="#">free to Message</a>
                                </li>
                                }*@
                                        </ul>
                                        <ul>
                                            <li>
                                                <p>
                                                    <span>Rs.</span>@Utility.Format(@personListing.MonthlyBudget)/month
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    <span> • </span>@personListing.User.Age year old
                                                    @Utility.GetEnumDisplayName(@personListing.gender)
                                                </p>
                                            </li>
                                        </ul>
                                    </div>
                                    <p>
                                        <a asp-action="findplacepreview" asp-controller="findplace" asp-route-listingId=@personListing.UId>
                                            @if (!string.IsNullOrEmpty(personListing.Introduction) && personListing.Introduction.Length >= 30)
                                            {
                                                <p>@personListing.Introduction.Substring(0, 30)....</p>
                                            }
                                            else
                                            {
                                                @personListing.Introduction
                                            }
                                        </a>
                                    </p>
                                    @if (personListing.MoveDate <= DateTime.UtcNow)
                                    {
                                        <div class="ltn__blog-btn">
                                            Available Now
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ltn__blog-btn">
                                            Available From @Utility.ConvertToShortDateFormat(personListing.MoveDate)
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
