@using Gharshare.CommonHelper
@using Gharshare.Models
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model HomeVM
@{
    ViewData["Title"] = "Pakistan biggest share accommodation website |";
    Layout = "_Layoutmain";
    var session = HttpContextAccessor.HttpContext.Session;
    Pager pager = new Pager();
    Pager pagerPerson = new Pager();
    int pageNo = 0;
    int pageNoPerson = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
    if (ViewBag.PagerPerson != null)
    {
        pagerPerson = ViewBag.PagerPerson;
        pageNoPerson = pagerPerson.CurrentPage;
    }
}
<!-- Pakistan biggest share accomodation website -->
