@using Gharshare.Models
@model StaticContent
@{
    ViewData["Title"] = "Local Guides ";
    Layout = "_Layoutmain";
}
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Local <span class="ltn__secondary-color-3">Guides </span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
<div class="row mb-5">
    <div class="col-lg-6">
        <img src="~/img/new/local_guides.webp" />
    </div>
    <div class="col-lg-6">
        @if (Model != null)
        {
            @Html.Raw(@Model.LowerSection)
        }
    </div>
</div>
</div>
 

