@{
    ViewData["Title"] = "How it works ";
    Layout = "_Layoutmain";
}
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        How <span class="ltn__secondary-color-3">it</span> Works?
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="ltn__blog-area ltn__blog-item-3-normal mt-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6">
                @* <h2>How It Works?</h2> *@
                <ul>
                    <li>
                        <strong>List Your Space: </strong>
                        Create a listing for your available room, providing details such as location, amenities,
                        and rental terms.
                    </li>
                    <li>
                        <strong>Search for Rooms:</strong>
                        Browse through listings to find rooms that match your preferences and budget.
                        Filter results based on location, price, and other criteria.
                    </li>
                    <li>
                        <strong>Connect with Potential Roommates or Tenants:</strong>
                        Communicate with interested parties via our messaging platform. Ask questions, arrange viewings,
                        and discuss rental agreements.
                    </li>
                    <li>
                        <strong>
                            Finalize Agreement:
                        </strong>
                        Once you've found the right match, finalize the rental agreement, including terms and move-in details.
                    </li>
                    <li>
                        <strong>
                            Enjoy Shared Living:
                        </strong>
                        Move in and enjoy your shared living experience! Benefit from cost savings, companionship,
                        and a comfortable living environment.
                    </li>
                </ul>
            </div>
            <div class="col-lg-6">
                <img src="~/img/new/How_it_works.webp" />
            </div>
        </div>
        <div class="ltn__video-popup-area ltn__video-popup-margin--- mb-5">
            <div class="ltn__video-bg-img ltn__video-popup-height-600--- bg-overlay-black-30 bg-image
            bg-fixed ltn__animation-pulse1" data-bs-bg="/img/bg/19.jpeg"
                 style="background-image: url(&quot;/img/bg/19.jpeg&quot;);">
                <h1 class="section-title">How <span>sharehouse.pk</span> works?</h1>
                <a class="ltn__video-icon-2 ltn__video-icon-2-border---"
                   href="https://www.youtube.com/embed/b2I39eDFpzQ?autoplay=1&amp;showinfo=0%22" data-rel="lightcase:myCollection">
                    <i class="fa fa-play"></i>
                </a>
            </div>
        </div>
    </div>
</div>

