@{
    ViewData["Title"] = "About us ";
    Layout = "_Layoutmain";
}
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        About <span class="ltn__secondary-color-3">Us</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="ltn__blog-area ltn__blog-item-3-normal mt-5">
    <div class="container">
        <div class="row">
            @* <h2 class="mb-3">About us</h2> *@
            <p class="mb-5">
                Welcome to sharehouse.pk! We're here to help you find or offer shared living spaces hassle-free.
                Whether you need a room or want to rent one out, we've got you covered.
                Our goal is to make finding or offering shared accommodations easy and straightforward.
                With our simple platform, you can create listings, search for rooms, and connect with potential
                roommates or tenants in no time.
            </p>
        </div>
        <div class="row mb-5">
            <div class="col-lg-6">
                <img src="~/img/new/about-us.webp" />
            </div>
            <div class="col-lg-6">
                <h3>Our Mission</h3>
                <p>
                    We offer our services throughout Pakistan, along with helpful tools and real estate experts,
                    to assist you in finding the perfect shared house accommodation.
                </p>
                <ul>
                    <li>
                        <strong>Room Listings:</strong>
                        <p>Easily advertise available rooms for rent.</p>
                    </li>
                    <li>
                        <strong>Roommate Matching:</strong>
                        <p>
                            Connect with compatible roommates.
                        </p>
                    </li>
                    <li>
                        <strong>Tenant Search:</strong>
                        <p>
                            Find suitable tenants for your space.
                        </p>
                    </li>
                    <li>
                        <strong>Messaging Platform:</strong> Communicate securely with potential
                        roommates or tenants.
                    </li>
                </ul>
            </div>
        </div>
        <div class="ltn__video-popup-area ltn__video-popup-margin--- mb-5">
            <div class="ltn__video-bg-img ltn__video-popup-height-600--- bg-overlay-black-30 bg-image
            bg-fixed ltn__animation-pulse1" data-bs-bg="/img/bg/19.jpeg"
                 style="background-image: url(&quot;/img/bg/19.jpeg&quot;);">
                <h1 class="section-title">How <span>sharehouse.pk</span> works?</h1>
                <a class="ltn__video-icon-2 ltn__video-icon-2-border---"
                   href="https://www.youtube.com/embed/b2I39eDFpzQ?autoplay=1&amp;showinfo=0%22" data-rel="lightcase:myCollection">
                    <i class="fa fa-play"></i>
                </a>
            </div>
        </div>
    </div>

