@using Gharshare.CommonHelper
@using Gharshare.Models
@using System.Text.RegularExpressions
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model List<Enquiry>
@{
    ViewData["Title"] = "sharehouse.pk|Inbox";
    var session = HttpContextAccessor.HttpContext.Session;
    var userId = session.GetString("_UserId");
    var userType = session.GetString("_UserType");
    string modalPopupId = string.Empty;
    if (userType == "admin" || userType == "superadmin") //admin or super admin
    {
        Layout = "_LayoutAdmin";
        modalPopupId = "#largeModal";
    }
    else
    {
        Layout = "_Layoutmain";
        modalPopupId = "#basicModal";
    }
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="container">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="email-left-box px-0 mb-3">
                    <div class="mail-list rounded mt-4">
                        <a id="inbox" asp-controller="message" asp-action="inbox" asp-route-type="to" class="list-group-item active"><i class="fa fa-inbox font-18 align-middle me-2"></i> Inbox @*<span class="badge badge-primary badge-sm float-end">198</span> *@</a>
                        <a id="sent" asp-controller="message" asp-action="inbox" asp-route-type="from" class="list-group-item"><i class="fa fa-paper-plane font-18 align-middle me-2"></i>Sent</a>

                    </div>
                </div>
                <div class="email-right-box ms-0 ms-sm-4 ms-sm-0">
                    <div role="toolbar" class="toolbar ms-1 ms-sm-0">
                    </div>
                    <div class="email-list mt-3">
                        @if (Model.Any())
                        {
                            var count = 1;
                            foreach (var enquiry in Model)
                            {
                                if (enquiry.Enquirystatus == Enquiry.EnquiryStatus.unread)
                                {
                                    <div class="message unread">
                                        <div class="d-flex message-single">
                                            <div class="ps-1 align-self-center">
                                                <div class="form-check custom-checkbox">
                                                    @*<input type="checkbox" class="form-check-input" id=@enquiry.ID>*@
                                                    <span class="align-self-center">@count</span>
                                                    <label class="form-check-label" for="checkbox9"></label>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="#" onclick="loadEnquiryinPopup(this.id)" data-bs-toggle="modal" data-bs-target=@modalPopupId id="@enquiry.ID" class="col-mail col-mail-2">
                                            <div class="name">
                                                <img src='@(enquiry.FromUser?.ProfilePicture ?? "/img/user-image.png")' class='rounded-lg me-2' width='24' alt=''>
                                                <span class="w-space-no">@enquiry.FromUser.Name</span>
                                                @*<span class="w-space-no">@Utility.GetEnumDisplayName(@enquiry.Enquirytype)</span>*@
                                            </div>
                                            <div class="subject">
                                                @{
                                                    string html = Utility.shortText(@enquiry.Message.Trim(), 30);
                                                    string plainText = Regex.Replace(html, "<.*?>", "");
                                                    plainText = System.Net.WebUtility.HtmlDecode(plainText);
                                                }
                                                @plainText
                                            </div>
                                            <div class="date">@Utility.ConvertToShortDateTime(@enquiry.DateReceived)</div>
                                        </a>
                                    </div>
                                }
                                else if (enquiry.Enquirystatus == Enquiry.EnquiryStatus.read)
                                {
                                    <div class="message">
                                        <div>
                                            <div class="d-flex message-single">
                                                <div class="mt-2">
                                                    <div class="form-check custom-checkbox">
                                                        @*<input type="checkbox" class="form-check-input" id=@enquiry.ID>*@
                                                        <span class="align-self-center">@count</span>
                                                        <label class="form-check-label" for="checkbox2"></label>
                                                    </div>
                                                </div>
                                            </div>
                                            <a onclick="loadEnquiryinPopup(this.id)" data-bs-toggle="modal" data-bs-target=@modalPopupId id="@enquiry.ID" class="col-mail col-mail-2">
                                                <div class="name">
                                                    <img src='@(enquiry.FromUser?.ProfilePicture ?? "/img/user-image.png")' class='rounded-lg me-2' width='24' alt=''>
                                                    <span class="w-space-no">@enquiry.FromUser.Name</span>
                                                </div>
                                                <div class="subject">
                                                    @{
                                                        string html = Utility.shortText(@enquiry.Message.Trim(), 30);
                                                        string plainText = Regex.Replace(html, "<.*?>", "");
                                                        plainText = System.Net.WebUtility.HtmlDecode(plainText);
                                                    }
                                                    @plainText
                                                </div>
                                                <div class="date">@Utility.ConvertToShortDateTime(@enquiry.DateReceived)</div>
                                            </a>
                                        </div>
                                    </div>
                                }
                                count += 1;
                            }
                        }
                        else
                        {
                            <p class="text-center">No message</p>
                        }
                    </div>
                    <!-- panel -->
                    <partial name="_Pager" model="@pager" />
                </div>
            </div>
        </div>
    </div>

</div>
<script src="~/js/message/loaEnquiryinPopup.js"></script>
<script src="~/js/message/selectActiveItem.js"></script>

