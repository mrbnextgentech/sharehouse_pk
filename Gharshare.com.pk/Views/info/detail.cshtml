@using Gharshare.CommonHelper
@using Gharshare.Models
@using Gharshare.CommonHelper
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model cmsVm
@{
    ViewData["Title"] = @Model.selectedContent.Heading;
    Layout = "_Layoutmain";
}
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        @Model.pageTitle <span class="ltn__secondary-color-3"></span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="ltn__blog-area ltn__blog-item-3-normal mt-5 mb-100">
    <div class="container">
        <hr />
        <div class="row">
            <div class="col-lg-8">
                <h3 class="mb-3">@Model.selectedContent.Heading</h3>
                @if (@Model.selectedContent.CreatedbyUser != null)
                {
                    <div class="row"><p>@Model.selectedContent.CreatedbyUser.Name</p></div>
                }
                <div class="row mb-3"><p>@Utility.ConvertToCustomDateFormat(@Model.selectedContent.CreatedOn)</p></div>
                <div class="row mb-3">
                    <p>@Model.selectedContent.Topsection</p>
                </div>
                @if (Model.selectedContent.Imagepath != null)
                {
                    <div class="row mb-5">
                        <img src="@Model.selectedContent.Imagepath" alt="article image">
                    </div>
                }
                <div class="row mb-3">
                    @Html.Raw(@Model.selectedContent.LowerSection)
                </div>
                <hr>
            </div>
            <div class="col-lg-4">
                <div class="styles__moreArticles___z_by6" role="presentation">
                    <div class="styles__headingBox___3VIO9">
                        <p class="styles__heading___35MAP">More @Model.pageTitle</p>
                    </div>
                    <div class="styles__articlesContainer___2bulR styles__collapse___2SWaI">
                        <div class="styles__divider___TaUM6"></div>
                        @if (Model.contents.Any())
                        {
                            foreach (var article in Model.contents)
                            {
                                string title = @article.Heading.Replace(" ", "_");
                                <a asp-action="detail" asp-route-id=@article.UId asp-route-title=@title>
                                    <p class="styles__articleText___3d7bZ">
                                        @article.Heading
                                    </p>
                                    <div class="styles__divider___TaUM6"></div>
                                </a>
                            }
                        }
                        <a asp-action="content" asp-controller="info" asp-route-type="@Model.articleType">
                            View all @Model.pageTitle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

