@using Gharshare.Models
@model PersonListingVM
@{
    ViewData["Title"] = "";
    Layout = "_Layout4Popups";
    //Layout = "_Layoutmain";
}
<div class="row justify-content-center h-100 align-items-center">
    <div class="col-md-12">
        <div class="authincation-content">
            <div class="row no-gutters">
                <div class="col-xl-12">
                    <div class="auth-form">
                        <form id="frmrent" enctype="multipart/form-data">
                            <input id="txtintroPersonId" type="hidden" asp-for="@Model.PersonListing.ID" />
                            <div class="row justify-content-center">
                                <div class="col-sm-12 mb-2">
                                    <div class="text-center row mb-3">
                                        <h4>General Information</h4>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="text-label form-label">Monthly budget</label>
                                            <input id="txtrent" type="text" asp-for="@Model.PersonListing.MonthlyBudget"
                                                   required class="ag form-control" placeholder="Rs.">
                                            <span id="spanrent" asp-validation-for="@Model.PersonListing.MonthlyBudget" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="text-label form-label">Preferred move date</label>
                                            <div class="input-group">
                                                <input type="text" id="txtMovedate" asp-for="@Model.PersonListing.MoveDate" class="datepicker form-control"
                                                       required readonly placeholder="Select a date">
                                                <span asp-validation-for="@Model.PersonListing.MoveDate" class="text-danger"></span>
                                                <div id="divCalenderIcon" class="input-group-text fa fa-calendar"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="text-label form-label">
                                                Preferred length of
                                                stay
                                            </label>
                                            <select class="mb-4 nice-select wide w-100" required asp-for="@Model.PersonListing.Length">
                                                <option value="@PersonListing.Stay.Unlimited">No limit</option>
                                                <option value="@PersonListing.Stay.OneMonth">One month</option>
                                                <option value="@PersonListing.Stay.TwoMonths">Two months</option>
                                                <option value="@PersonListing.Stay.ThreeMonths">Three months</option>
                                                <option value="@PersonListing.Stay.SixMonths">Six months</option>
                                                <option value="@PersonListing.Stay.NineMonths">Nine months</option>
                                                <option value="@PersonListing.Stay.Plus12Months">12+ months</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-3 text-center">
                                        <button type="submit" class="btn btn-primary w-50">
                                            Update
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<partial name="_dtpPartial" />
<script src="~/js/listings/findplace/updateRent.js"></script>
