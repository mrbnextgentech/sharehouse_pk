@using Gharshare.Models
@using Microsoft.AspNetCore.Identity
@model PersonListingVM
@inject UserManager<ApplicationUser> _userManager
@{
    ViewData["Title"] = "Find a place";
    Layout = "_Layout4Listings";
    var user = await _userManager.GetUserAsync(User);
}
<div class="container-fluid">
    <!-- row -->
    <div class="row">
        <div class="col-xl-12 col-xxl-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">DESCRIBE YOUR IDEAL PLACE</h4>
                </div>
                <div class="card-body">
                    <div id="smartwizard">
                        <ul class="nav">
                            <li class="nav-item">
                                <a class="nav-link" href="#accommodationtype">
                                    <span class="num">Accommodation Type</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#area">
                                    <span class="num">Preferred Area</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#rent">
                                    <span class="num">Rent and timing</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#preferences">
                                    <span class="num">Property preferences</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#intro">
                                    <span class="num">About you</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#employmentstatus">
                                    <span class="num">Employment status</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#Lifestyle">
                                    <span class="num">Life style</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#preview">
                                    <span class="num">Preview</span>
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div id="accommodationtype" class="tab-pane" role="tabpanel">
                                <form id="frmaccommodationtypestep">
                                    <input id="txtacctypePersonId" type="hidden"
                                           asp-for="@Model.PersonListing.ID" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2">
                                            <h4>
                                                What type of accommodation are you
                                                looking for?
                                            </h4>
                                            <input id="txtaccommodationtype" type="hidden" value="wholeproperty" />
                                            <div class="row mt-3">
                                                @if (Model.PropertyTypes.Any())
                                                {
                                                    @for (int i = 0; i < Model.PropertyTypes.Count(); i++)
                                                    {
                                                        <div class="col-lg-3 col-sm-6 col-6">
                                                            <div class="text-center mt-3">
                                                                <label>
                                                                    <input type="hidden" asp-for="@Model.PropertyTypes[i].ID">
                                                                    <input class="type radio-input" type="checkbox" asp-for="@Model.PropertyTypes[i].isSelected">
                                                                    <span class="radio-tile">
                                                                        <span class="radio-icon">
                                                                            <img src="@Model.PropertyTypes[i].iconPath" />
                                                                        </span>
                                                                    </span>
                                                                </label>
                                                                <p>@Model.PropertyTypes[i].Title</p>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            <div class="row mt-3">
                                                <div class="Teamsup">
                                                    <div class="Teamsupheader">
                                                        <div>
                                                            <input type="checkbox" id="TeamsUp" asp-for="@Model.PersonListing.TeamsUp">
                                                            <label role="button" for="TeamsUp">Teamups</label>
                                                        </div>
                                                        <span class="icon">
                                                            <svg width="24" height="23" label="">
                                                                <path d="M18.254 17.165c.645.222 1.175.98 1.175 1.683v3.194H4.572v-3.194c0-.704.529-1.46 1.174-1.683l3.49-1.2c.733.739 1.718 1.211 2.764 1.211 1.047 0 2.031-.472 2.764-1.211l3.49 1.2zM12 6.708c2.005 0 3.376 1.67 3.046 3.712l-.5 3.091C14.35 14.737 13.204 15.74 12 15.74c-1.204 0-2.348-1.002-2.546-2.228l-.5-3.091C8.622 8.378 9.993 6.708 12 6.708zm11.143 1.198v1.917h-1.857v1.917h-1.858V9.823h-1.857V7.906h1.857V5.99h1.858v1.916h1.857zM8.538 6.87c-.672.819-1.023 1.872-1.019 2.978-.89-.313-1.626-1.126-1.78-2.085l-.5-3.092C4.908 2.628 6.278.958 8.285.958c2.005 0 3.375 1.67 3.046 3.712l-.108.672a4.385 4.385 0 0 0-2.686 1.527zm-3.234 8.932a2.894 2.894 0 0 0-.87.49H.858v-3.193c0-.704.53-1.46 1.176-1.683l3.488-1.2a4.042 4.042 0 0 0 2.172 1.145l.386 2.387c.056.35.173.678.315.993l-3.09 1.061z" fill="#2F3A4A" fill-rule="evenodd"></path>
                                                            </svg>
                                                        </span>
                                                    </div>
                                                    <p>
                                                        Teamups are when you get together with others who are looking for accommodation and start a new share house together.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="area" class="tab-pane" role="tabpanel">
                                <form id="frmareastep">
                                    <input id="txtareaPersonId" type="hidden"
                                           asp-for="@Model.PersonListing.ID" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2">
                                            <h4> Where would you like to live?</h4>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Suburb</label>
                                                <input id="txtSuburb" type="text" class="op form-control"
                                                       required asp-for="@Model.PersonListing.Suburb"
                                                       placeholder="Search for a suburb">
                                                <p>We recommend entering at least 4 locality separting each with semi-colon ';'.</p>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="rent" class="tab-pane" role="tabpanel">
                                <form id="frmrentstep">
                                    <input id="txtrentPersonId" type="hidden" asp-for="@Model.PersonListing.ID" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2">
                                            <div class="mb-3">
                                                <h4>Rent and timing</h4>
                                                <label class="text-label form-label">Monthly budget</label>
                                                <input id="txtrent" type="text" asp-for="@Model.PersonListing.MonthlyBudget"
                                                       required class="ag form-control" placeholder="Rs.">
                                                <span asp-validation-for="@Model.PersonListing.MonthlyBudget" class="text-danger"></span>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Preferred move date</label>
                                                <div class="input-group">
                                                    <input type="text" id="txtMovedate" asp-for="@Model.PersonListing.MoveDate" class="datepicker form-control"
                                                           required readonly placeholder="Select a date">
                                                    <span asp-validation-for="@Model.PersonListing.MoveDate" class="text-danger"></span>
                                                    <div id="divCalenderIcon" class="input-group-text fa fa-calendar"></div>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Preferred length of
                                                    stay
                                                </label>
                                                <select class="mb-4 nice-select wide w-100" required asp-for="@Model.PersonListing.Length">
                                                    <option value="@PersonListing.Stay.Unlimited" selected>No limit</option>
                                                    <option value="@PersonListing.Stay.OneMonth">One month</option>
                                                    <option value="@PersonListing.Stay.TwoMonths">Two months</option>
                                                    <option value="@PersonListing.Stay.ThreeMonths">Three months</option>
                                                    <option value="@PersonListing.Stay.SixMonths">Six months</option>
                                                    <option value="@PersonListing.Stay.NineMonths">Nine months</option>
                                                    <option value="@PersonListing.Stay.Plus12Months">12+ months</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="preferences" class="tab-pane" role="tabpanel">
                                <form id="frmpreferencestep">
                                    <input id="txtpreferencePersonId" type="hidden" asp-for="@Model.PersonListing.ID" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2">
                                            <div class="mb-2">
                                                <h4>Property preferences</h4>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Room furnishings</label>
                                                <div class="btn-group w-100" role="group"
                                                     aria-label="Basic radio toggle button group">
                                                    <input type="radio" class="btn-check"
                                                           asp-for="@Model.PersonListing.FurnishingType"
                                                           id="radioflexible" value="@PersonListing.RoomFurnishing.Flexible">
                                                    <label class="btn btn-outline-primary"
                                                           for="radioflexible">Flexible</label>
                                                    <input type="radio" class="btn-check" id="radiofurnished"
                                                           asp-for="@Model.PersonListing.FurnishingType" checked
                                                           value="@PersonListing.RoomFurnishing.Furnished">
                                                    <label class="btn btn-outline-primary"
                                                           for="radiofurnished">Furnished</label>
                                                    <input type="radio" class="btn-check" id="radioUnfurnished"
                                                           asp-for="@Model.PersonListing.FurnishingType" value="@PersonListing.RoomFurnishing.UnFurnished">
                                                    <label class="btn btn-outline-primary"
                                                           for="radioUnfurnished">Not required</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Internet</label>
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input asp-for="@Model.PersonListing.InternetStatus" value="@PersonListing.Internet.Flexible"
                                                           type="radio" class="btn-check" id="Int_Flexible" checked>
                                                    <label class="btn btn-outline-primary" for="Int_Flexible">Flexible</label>
                                                    <input asp-for="@Model.PersonListing.InternetStatus" value="@PersonListing.Internet.Required"
                                                           type="radio" class="btn-check" id="Int_Required">
                                                    <label class="btn btn-outline-primary" for="Int_Required">required</label>
                                                    <input asp-for="@Model.PersonListing.InternetStatus" value="@PersonListing.Internet.Notrquired"
                                                           type="radio" class="btn-check" id="Int_notRequired">
                                                    <label class="btn btn-outline-primary" for="Int_notRequired">Not required</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Bathroom type</label>
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input asp-for="@Model.PersonListing.Type" value="@PersonListing.Bath.Flexible"
                                                           type="radio" class="btn-check" id="Bathroom_Flexible">
                                                    <label class="btn btn-outline-primary" for="Bathroom_Flexible">Flexible</label>
                                                    <input asp-for="@Model.PersonListing.Type" value="@PersonListing.Bath.Ensuite" checked
                                                           type="radio" class="btn-check" id="Ensuite">
                                                    <label class="btn btn-outline-primary" for="Ensuite">
                                                        Ensuite
                                                        or
                                                        own required
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Parking</label>
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input asp-for="@Model.PersonListing.ParkingType" value="@PersonListing.Parking.Flexible"
                                                           type="radio" class="btn-check" id="Parking_Flexible" checked>
                                                    <label class="btn btn-outline-primary" for="Parking_Flexible">Flexible</label>
                                                    <input asp-for="@Model.PersonListing.ParkingType" value="@PersonListing.Parking.Offstree"
                                                           type="radio" class="btn-check" id="Off_Street">
                                                    <label class="btn btn-outline-primary" for="Off_Street">Off-street required</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Max number of
                                                    flatmates
                                                </label>
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input asp-for="@Model.PersonListing.MaxNo" value="@PersonListing.Flatmates.Flexible" checked
                                                           type="radio" class="btn-check" id="Max_Flexible">
                                                    <label class="btn btn-outline-primary" for="Max_Flexible">Flexible</label>
                                                    <input asp-for="@Model.PersonListing.MaxNo" value="@PersonListing.Flatmates.OneOther"
                                                           type="radio" class="btn-check" id="1_Other">
                                                    <label class="btn btn-outline-primary" for="1_Other">
                                                        1
                                                        other
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.MaxNo" value="@PersonListing.Flatmates.TwoOthers"
                                                           type="radio" class="btn-check" id="2_Other">
                                                    <label class="btn btn-outline-primary" for="2_Other">
                                                        2
                                                        other
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="intro" class="tab-pane " role="tabpanel">
                                <form id="frmintrostep" enctype="multipart/form-data">
                                    <input id="txtintroPersonId" type="hidden" asp-for="@Model.PersonListing.ID" />
                                    <input id="txtUserId" type="hidden" value="@user.Id" />
                                    <input id="txtListingUserId" type="hidden" asp-for="@Model.PersonListing.User.Id" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2">
                                            <h4>About you </h4>
                                            <div class="mt-3 mb-3 text-center">
                                                <h4>Your profile picture</h4>
                                                <div class="rounded-image mb-3 mt-3 text-center">
                                                    <div id="profilePic">
                                                        @if (user.ProfilePicture == null || user.ProfilePicture == "")
                                                        {
                                                            <img src="~/img/user-image.png" alt="Rounded Image"
                                                             onclick="document.getElementById('file-upload').click();" />
                                                        }
                                                        else
                                                        {
                                                            <img src="@user.ProfilePicture" alt="Rounded Image"
                                                             onclick="document.getElementById('file-upload').click();" />
                                                        }
                                                    </div>
                                                    <input id="file-upload" type="file" accept="image/*" style="display: none;"
                                                           onchange="validateAndUploadImage(this);" />
                                                </div>
                                                <p>You can add or change your listing picture by changing profile picture</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">This place is for</label>
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input id="radioMe" asp-for="@Model.PersonListing.PlaceFor" value="@PersonListing.Purpose.Me"
                                                           type="radio" class="btn-check" id="radioMe" checked>
                                                    <label class="btn btn-outline-primary" for="radioMe">Me</label>
                                                    <input id="radioCouple" asp-for="@Model.PersonListing.PlaceFor" value="@PersonListing.Purpose.Couple"
                                                           type="radio" class="btn-check">
                                                    <label class="btn btn-outline-primary" for="radioCouple">couples</label>
                                                    <input id="radioGroup" asp-for="@Model.PersonListing.PlaceFor" value="@PersonListing.Purpose.Group"
                                                           type="radio" class="btn-check">
                                                    <label class="btn btn-outline-primary" for="radioGroup">Group</label>
                                                </div>
                                            </div>
                                            <div id="divgroup" style="display:none;" class="mb-3">
                                                <label class="text-label form-label">
                                                    Total Person in the group?
                                                </label>
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.One"
                                                           type="radio" class="tp btn-check" id="rdoone">
                                                    <label class="btn btn-outline-primary" for="rdoone">1</label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Two"
                                                           type="radio" class="tp btn-check" id="rdo2">
                                                    <label class="btn btn-outline-primary" for="rdo2">
                                                        2
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Three"
                                                           type="radio" class="tp btn-check" id="rdo3">
                                                    <label class="btn btn-outline-primary" for="rdo3">
                                                        3
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Four"
                                                           type="radio" class="tp btn-check" id="rdo4">
                                                    <label class="btn btn-outline-primary" for="rdo4">
                                                        4
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Five"
                                                           type="radio" class="btn-check" id="rdo5">
                                                    <label class="tp btn btn-outline-primary" for="rdo5">
                                                        5
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Six"
                                                           type="radio" class="btn-check" id="rdo6">
                                                    <label class="tp btn btn-outline-primary" for="rdo6">
                                                        6
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Seven"
                                                           type="radio" class="btn-check" id="rdo7">
                                                    <label class="tp btn btn-outline-primary" for="rdo7">
                                                        7
                                                    </label>
                                                    <input asp-for="@Model.PersonListing.Totalpersons" value="@PersonListing.TotalPersons.Eight"
                                                           type="radio" class="btn-check" id="rdo8">
                                                    <label class="tp btn btn-outline-primary" for="rdo8">
                                                        8
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Your first name</label>
                                                <input type="text" id="txtmyname" asp-for="@Model.PersonListing.FirstName" required
                                                       value="@user.Name" readonly class="op form-control" placeholder="Enter First Name">
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    City
                                                </label>
                                                <div id="dvCitylist">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Your age</label>
                                                <input type="text" asp-for="@Model.PersonListing.User.Age" class="ag form-control" id="txtmyage"
                                                       placeholder="Enter Your age" required>
                                            </div>
                                            <label class="text-label form-label">
                                                The gender you identify as
                                            </label>
                                            <div class="mb-3">
                                                <div class="btn-group w-100" role="group" aria-label="Basic radio toggle button group">
                                                    <input asp-for="@Model.PersonListing.User.Gender" value="@ApplicationUser.gender.female"
                                                           type="radio" class="gender btn-check" id="Woman">
                                                    <label class="btn btn-outline-primary" for="Woman">Female</label>
                                                    <input asp-for="@Model.PersonListing.User.Gender" value="@ApplicationUser.gender.male"
                                                           type="radio" class="gender btn-check" id="Man">
                                                    <label class="btn btn-outline-primary" for="Man">Male</label>
                                                    <input asp-for="@Model.PersonListing.User.Gender" value="@ApplicationUser.gender.transgender"
                                                           type="radio" class="gender btn-check" id="Non_Binary">
                                                    <label class="btn btn-outline-primary" for="Non_Binary">Transgender</label>
                                                    <input asp-for="@Model.PersonListing.User.Gender" value="@ApplicationUser.gender.undisclosed" checked
                                                           type="radio" class="gender btn-check" id="Gender_Diverse">
                                                    <label class="btn btn-outline-primary" for="Gender_Diverse">Undisclosed</label>
                                                    @*<input asp-for="@Model.PersonListing.gender" value="@PersonListing.Gender.Woman"
                                                    type="radio" class="gender btn-check" id="Woman">
                                                    <label class="btn btn-outline-primary" for="Woman">Woman</label>
                                                    <input asp-for="@Model.PersonListing.gender" value="@PersonListing.Gender.Man"
                                                    type="radio" class="gender btn-check" id="Man">
                                                    <label class="btn btn-outline-primary" for="Man">Man</label>
                                                    <input asp-for="@Model.PersonListing.gender" value="@PersonListing.Gender.Transgender"
                                                    type="radio" class="gender btn-check" id="Non_Binary">
                                                    <label class="btn btn-outline-primary" for="Non_Binary">Transgender</label>
                                                    <input asp-for="@Model.PersonListing.gender" value="@PersonListing.Gender.Undisclosed" checked
                                                    type="radio" class="gender btn-check" id="Gender_Diverse">
                                                    <label class="btn btn-outline-primary" for="Gender_Diverse">Undisclosed</label>*@
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">Introduce Yourself</label>
                                                <textarea class="form-control" rows="4"
                                                          asp-for="PersonListing.Introduction" required
                                                          id="myintro" style="height: 100px;"
                                                          placeholder="Say something about yourself...">                                                   
                                                </textarea>
                                                <p>
                                                    Tell your potential flatmate a little about yourself and
                                                    the other flatmates living in the home. Describe what you do
                                                    for work, where you're all from and what you do for fun.
                                                </p>
                                            </div>
                                            <div id="divotherPerson">
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="employmentstatus" class="tab-pane" role="tabpanel">
                                <form id="frmemploymentstatusstep">
                                    <input id="txtempstatusPersonId" type="hidden" asp-for="@Model.PersonListing.ID" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2">
                                            <h4>Employment status</h4>
                                            <div id="divEmploymentStatus" class="row mt-3">
                                                <div class="col-lg-3 col-sm-6 col-6">
                                                    <div class="text-center mt-3">
                                                        <label>
                                                            <input class="radio-input" type="checkbox" name="features">
                                                            <span class="radio-tile">
                                                                <span class="radio-icon">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 576 512">
                                                                        <path d="M208 64a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zM9.8 214.8c5.1-12.2 19.1-18 31.4-12.9L60.7 210l22.9-38.1C99.9 144.6 129.3 128 161 128c51.4 0 97 32.9 113.3 81.7l34.6 103.7 79.3 33.1 34.2-45.6c6.4-8.5 16.6-13.3 27.2-12.8s20.3 6.4 25.8 15.5l96 160c5.9 9.9 6.1 22.2 .4 32.2s-16.3 16.2-27.8 16.2H288c-11.1 0-21.4-5.7-27.2-15.2s-6.4-21.2-1.4-31.1l16-32c5.4-10.8 16.5-17.7 28.6-17.7h32l22.5-30L22.8 246.2c-12.2-5.1-18-19.1-12.9-31.4zm82.8 91.8l112 48c11.8 5 19.4 16.6 19.4 29.4v96c0 17.7-14.3 32-32 32s-32-14.3-32-32V405.1l-60.6-26-37 111c-5.6 16.8-23.7 25.8-40.5 20.2S-3.9 486.6 1.6 469.9l48-144 11-33 32 13.7z"></path>
                                                                    </svg>
                                                                </span>
                                                            </span>
                                                        </label>
                                                        <p>Working full-time</p>
