@using Gharshare.Models
@model Property
@{
    ViewData["Title"] = "Edit about flatmates";
    Layout = "_Layout4Popups";
}
<div class="row justify-content-center h-100 align-items-center">
    <div class="col-md-12">
        <div class="authincation-content">
            <div class="row no-gutters">
                <div class="col-xl-12">
                    <div class="auth-form">
                        <h4 class="text-center mb-3">
                            Edit About Flatmates
                        </h4>
                        <form id="frmaboutflatmates">
                            <input id="txtPropertyId" type="hidden" asp-for="ID" />
                            <div class="col-lg-12 mb-2">
                                <div class="mb-3">
                                    <label class="text-label form-label">About Flatmates</label>
                                    <div class="form-inline">
                                        <textarea id="txtaboutflatmates" rows="20" style="height:200px;"
                                                  class="form-control" asp-for="AboutFlatmates">
                                        </textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3 text-center">
                                <button type="submit" class="btn btn-primary w-50">
                                    Update
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/listings/updateAboutflatmates.js"></script>
