@using Gharshare.Models
@using Microsoft.AspNetCore.Identity
@model PropertyListingVM
@*@inject UserManager<ApplicationUser> _userManager*@
@{
    ViewData["Title"] = "Video tour and inspection times";
    Layout = "_Layout4Listings";     
}
<div class="container-fluid">
    <!-- row -->
    <div class="row">
        <div class="col-xl-12 col-xxl-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Video tour and inspection times</h4>
                </div>
                <div class="card-body">
                    <div id="smartwizard">
                        <ul class="nav">
                            <li class="nav-item">
                                <a class="nav-link" href="#inspectionsettings">
                                    <span class="num">Inspection settings</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#availability">
                                    <span class="num">Your availabilities</span>
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            @* <div id="videotour" class="tab-pane" role="tabpanel">
                            <form id="frmvideotour">
                            <input id="txtvListingId" type="hidden"
                            asp-for="@Model.Property.ID" />
                            <div class="row justify-content-center">
                            <div class="col-sm-6 mb-2 mt-3">
                            <h4>
                            Add a video tour
                            </h4>
                            <p>
                            Adding a video tour is a great way to reduce the number of in-person
                            inspections required. A video tour helps potential flatmates view your home
                            and get to know your current flatmates, without having to meet in person.
                            </p>
                            <div class="mb-3">
                            <div class="input-group">
                            <input id="txtvideourl" class="form-control" type="text" asp-for="@Model.Property.VideoURL" required
                            placeholder="Enter a link to your video tour" />
                            </div>
                            <p>A link to your video tour</p>
                            </div>
                            </div>
                            </div>
                            </form>
                            </div>*@
                            <div id="inspectionsettings" class="tab-pane" role="tabpanel">
                                <form id="frmInspectionsettings">
                                    <input id="txtpropertyId" type="hidden"
                                           asp-for="@Model.Property.ID" />
                                    <div class="row justify-content-center">
                                        <div class="col-sm-6 mb-2 mt-3">
                                            <h4> Inspection settings</h4>
                                            <p>
                                                <strong>Your privacy:</strong> Your address is private but can be shared during the
                                                inspection process based on your preference below
                                            </p>
                                            <p>
                                                <strong>How it works:</strong> Invite someone to view and book an inspection time
                                                via the “Share inspection times” button in Messages.
                                            </p>
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    When would you like us to share your address?
                                                </label>
                                            </div>
                                            <div id="inspection">
                                                <div class="form-check custom-checkbox ms-1 mb-1 ">
                                                    <input type="radio" asp-for="@Model.Property.InspectionTime"
                                                           value="1" class="form-check-input"
                                                           checked="@(Model.Property.InspectionTime ==@Property.Inspection.duringbooking  ? true : false)" />
                                                    <label class="form-check-label">
                                                        During booking – When someone is booking an inspection
                                                    </label>
                                                </div>
                                                <div class="form-check custom-checkbox ms-1 mb-1">
                                                    <input type="radio" asp-for="@Model.Property.InspectionTime"
                                                           checked="@(Model.Property.InspectionTime ==@Property.Inspection.afterbooking  ? true : false)"
                                                           value="2" class="form-check-input" />
                                                    <label class="form-check-label">
                                                        After booking – After someone has booked an inspection
                                                    </label>
                                                </div>
                                                <div class="form-check custom-checkbox ms-1 mb-1 ">
                                                    <input type="radio" asp-for="@Model.Property.InspectionTime"
                                                           checked="@(Model.Property.InspectionTime ==@Property.Inspection.dontshare  ? true : false)"
                                                           value="3" class="form-check-input" />
                                                    <label class="form-check-label">
                                                        Don’t share – I will share my address when appropriate
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Navigation instructions
                                                </label>
                                                <div class="input-group">
                                                    <textarea asp-for="@Model.Property.NavigationInstructions"
                                                              class="form-control" rows="4" required
                                                              style="height: 200px;"
                                                              placeholder="Help people find your place (optional)">
                                                </textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="availability" class="tab-pane" role="tabpanel">
                                <div class="row justify-content-center">
                                    <div class="col-sm-6 mb-2 mt-3">
                                        <form id="frminspection">
                                            <input id="txtInspectionPropertyId" type="hidden"
                                                   asp-for="@Model.Property.ID" />
                                            <div class="row justify-content-center">
                                                <div class="mb-2 mt-3">
                                                    <h4>
                                                        Your availabilities
                                                    </h4>
                                                </div>
                                                <div class="mb-2 mt-3">
                                                    <h4>
                                                        How long will your inspections be?
                                                    </h4>
                                                </div>
                                                <div class="col-lg-12 mb-2">
                                                    <div class="mb-3">
                                                        <label class="text-label form-label">
                                                            Length of each inspection
                                                        </label>
                                                       <select id="ddllength" asp-for="@Model.Property.InspectionLength" 
                                                        class="nice-select wide w-100 mb-3">
                                                            <option value="">select preference</option>
                                                            <option value="10 mins">10 mins</option>
                                                            <option value="15 mins">15 mins</option>
                                                            <option value="20 mins">20 mins</option>
                                                            <option value="25 mins">25 mins</option>
                                                            <option value="30 mins">30 mins</option>
                                                            <option value="45 mins">45 mins</option>
                                                            <option value="60 mins">60 mins</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="text-label form-label">
                                                            Break between inspections
                                                        </label>
                                                        <select id="ddlbreak" asp-for="@Model.Property.InspectionBreak" 
                                                        class="nice-select wide w-100 mb-3">
                                                            <option value="">select preference</option>
                                                            <option value="0 mins">0 mins</option>
                                                            <option value="5 mins">5 mins</option>
                                                            <option value="10 mins">10 mins</option>
                                                        </select>
                                                    </div>
                                                    <div id="inspection">
                                                        <div class="row mb-3 inspection">
                                                            <div class="col-md-6">
                                                                <label class="text-label form-label">Inspection date?</label>
                                                                <div class="input-group">
                                                                    <input type="text" asp-for="@Model.Inspections[0].InspectionDate"
                                                                           class="datepicker form-control">
                                                                    <div class="input-group-text fa fa-calendar"></div>
                                                                    <span class="text-danger"
                                                                          asp-validation-for="@Model.Inspections[0].InspectionDate"></span>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="text-label form-label">
                                                                    From
                                                                </label>
                                                                <select asp-for="@Model.Inspections[0].From" class="nice-select wide w-100 mb-3">
                                                                    <option value="">--Pick time--</option>
                                                                    <option value="09:00 am">09:00 am</option>
                                                                    <option value="09:00 am">09:30 am</option>
                                                                    <option value="09:30 am">10:00 am</option>
                                                                    <option value="10:00 am">10:30 am</option>
                                                                    <option value="10:30 am">11:00 am</option>
                                                                    <option value="10:30 am">11:30 am</option>
                                                                    <option value="11:30 pm">12:00 pm</option>
                                                                    <option value="12:00 pm">12:30 pm</option>
                                                                    <option value="12:30 pm">01:00 pm</option>
                                                                    <option value="01:30 pm">01:30 pm</option>
                                                                    <option value="02:30 pm">02:00 pm</option>
                                                                    <option value="02:30 pm">02:30 pm</option>
                                                                    <option value="03:00 pm">03:00 pm</option>
                                                                    <option value="03:00 pm">03:30 pm</option>
                                                                    <option value="03:00 pm">04:00 pm</option>
                                                                    <option value="04:00 pm">04:30 pm</option>
                                                                    <option value="04:30 am">05:00 pm</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="text-label form-label">
                                                                    To
                                                                </label>
                                                                <select asp-for="@Model.Inspections[0].To" class="nice-select wide w-100 mb-3">
                                                                    <option value="">--Pick time--</option>                                                                     
                                                                    <option value="09:00 am">09:30 am</option>
                                                                    <option value="09:30 am">10:00 am</option>
                                                                    <option value="10:00 am">10:30 am</option>
                                                                    <option value="10:30 am">11:00 am</option>
                                                                    <option value="10:30 am">11:30 am</option>
                                                                    <option value="11:30 pm">12:00 pm</option>
                                                                    <option value="12:00 pm">12:30 pm</option>
                                                                    <option value="12:30 pm">01:00 pm</option>
                                                                    <option value="01:30 pm">01:30 pm</option>
                                                                    <option value="02:30 pm">02:00 pm</option>
                                                                    <option value="02:30 pm">02:30 pm</option>
                                                                    <option value="03:00 pm">03:00 pm</option>
                                                                    <option value="03:00 pm">03:30 pm</option>
                                                                    <option value="03:00 pm">04:00 pm</option>
                                                                    <option value="04:00 pm">04:30 pm</option>
                                                                    <option value="04:30 am">05:00 pm</option>
                                                                </select>
                                                            </div>
                                                            <a href="#" class="text-end delete">Remove Inspection Time</a>
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                            <a id="addinspection" href="#" >Add new time</a>
                                                        </div>
                                                    <div class="mb-3">
                                                        <button class="btn btn-primary btn-block"
                                                                type="submit">
                                                            Save inspection
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/listings/createVideotour-Inspection.js"></script>
<script src="~/js/listings/savePropertyinspections.js"></script>
<script src="~/js/listings/addNewInspection.js"></script>
<script>
    function closeListPlace() {

    }
</script>