                                                        </div>
                                                    </div>
                                                    <div id="images" class="row mb-3 mt-3"></div>
                                                </div>
                                                <p>
                                                    sharehouse.pk Hot Tip: for your safety, please don't upload
                                                    images of the front of your home.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="flatmate_preference" class="tab-pane" role="tabpanel">
                                <form id="frmflatmatepreferencestep">
