                                        <div id="divroomavailbility" class="col-sm-6 mb-2"
                                             style="display:none;">
                                            @for (int i = 0; i < @Model.Room.Count(); i++)
                                            {
                                                <h4>Room-@(i + 1) Availability</h4>
                                                <div class="mb-3">
                                                    <label class="text-label form-label">Date available</label>
                                                    <input type="text" asp-for="@Model.Room[i].AvailableFrom"
                                                           class="datepicker form-control" readonly>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="text-label form-label">
                                                        Minimum length of stay
                                                    </label>
                                                    <select asp-for="@Model.Room[i].MinStay"
                                                            class="nice-select wide w-100">
                                                        <option value="@Room.MinimumStay.None" selected>No minimum stay</option>
                                                        <option value="@Room.MinimumStay.OneMonth">1 month</option>
                                                        <option value="@Room.MinimumStay.TwoMonth">2 months</option>
                                                        <option value="@Room.MinimumStay.FourMonth">4 months</option>
                                                        <option value="@Room.MinimumStay.Sixmonth">6 months</option>
                                                        <option value="@Room.MinimumStay.Twelvemonth">12 months</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="text-label form-label mt-3">
                                                        Maximum length of stay
                                                    </label>
                                                    <select asp-for="@Model.Room[i].MaxStay" class="nice-select wide w-100">
                                                        <option value="@Room.MaximumStay.None">
                                                            No maximum stay
                                                        </option>
                                                        <option value="@Room.MaximumStay.OneMonth">1 month</option>
                                                        <option value="@Room.MaximumStay.SixMonths">6 months</option>
                                                        <option value="@Room.MaximumStay.OneYear">1 year</option>
                                                        <option value="@Room.MaximumStay.TwoYears">2 years</option>
                                                        <option value="@Room.MaximumStay.ThreeYears">3 years</option>
                                                        <option value="@Room.MaximumStay.FiveYears">5 years or more</option>
                                                    </select>
                                                </div>
                                                <hr />
                                            }
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div id="propertyimages" class="tab-pane " role="tabpanel">
                                <form id="frmpropertyimagesstep" enctype="multipart/form-data">
                                    <input id="txtimagePropertyId" type="hidden" asp-for="@Model.Property.ID" />
