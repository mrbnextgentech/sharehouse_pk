                                                           for="radiowomenonly">
                                                        Women
                                                        only
                                                    </label>
                                                    <input type="radio" class="btn-check"
                                                           id="radiomenonly"
                                                           asp-for="Property.Flatmatepreference"
                                                           value="@Property.Preference.Menonly" />
                                                    <label class="btn btn-outline-primary" for="radiomenonly">
                                                        Men
                                                        only
                                                    </label>
                                                    <input type="radio" class="btn-check"
                                                           id="radionocouple"
                                                           asp-for="Property.Flatmatepreference"
                                                           value="@Property.Preference.Nocouples" />
                                                    <label class="btn btn-outline-primary" for="radionocouple">
                                                        No
                                                        couples
                                                    </label>
                                                    <input type="radio" class="btn-check"
                                                           id="radiocouple"
                                                           asp-for="Property.Flatmatepreference"
                                                           value="@Property.Preference.couple" />
                                                    <label class="btn btn-outline-primary"
                                                           for="radiocouple">couples</label>
                                                    <input type="radio" class="btn-check"
                                                           id="radioanyone" checked
                                                           asp-for="Property.Flatmatepreference"
                                                           value="@Property.Preference.AnyoneIncCouples" />
                                                    <label class="btn btn-outline-primary" for="radioanyone">
                                                        Anyone
