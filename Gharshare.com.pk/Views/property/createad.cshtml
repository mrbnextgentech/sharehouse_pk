@using Microsoft.AspNetCore.Identity
@using Gharshare.Models
@using Gharshare.CommonHelper
@model PropertyVM
@inject UserManager<ApplicationUser> userManager;
@{
    ViewData["Title"] = "Create Ad";
    if (User.IsInRole(WebSiteRoles.Role_Admin))
    {
        Layout = "_Layout_1";
    }
    else if (User.IsInRole(WebSiteRoles.Role_FreeUser))
    {
        Layout = "_LayoutLandlord";
    }
}
<div class="container-fluid">

    <!-- row -->
    <div class="row">
        <div class="col-xl-12 col-xxl-12">
            <div class="card">
                <div class="card-body">
                    <div class="row" style="margin-top:10px;">
                        <div class="col-md-5" style="border-left: 5px solid #FF005D;margin-left:10px; padding-left:10px;">
                            <div class="bd-callout bd-callout-default">
                                <p><b>Property Address:</b> Bannister Road</p>
                                <p><b>Advertise Your Property</b></p>
                                <p> Start creating an ad your property and advertise on our site</p>
                                @*<div class="callout-access">
                                <div style="display: flex;">
                                <img src="~/img/tool-tip.png" style="height:20px;width:20px;" alt="More Info on Create Ad">
                                <p>Would like to know more about creating an ad? Take a look at the
                                preview</p>
                                </div>
                                <a href="" class="btn btn-primary">
                                <span class="nav-text">How to create an ad</span>
                                </a>
                                </div>*@
                            </div>
                        </div>
                        <div class="col-md-6 bd-callout bd-callout-default" id="tipSection">
                            <strong>Your property has been officially set up.</strong><br>
                            If you're looking to add an additional property, please
                            <a href="#" target="_blank">click here</a>
                        </div>
                    </div>
                    <form id="createAdd" asp-action="createad" enctype="multipart/form-data" asp-controller="property">
                        <input type="hidden" id="cover" asp-for=Property.CoverImage value="@Model.Property.CoverImage" />
                        <input type="hidden" id="PID" asp-for=Property.ID value="@Model.Property.ID" />
                        <input type="hidden" id="SID" asp-for=Landlord.StateID value="@Model.Landlord.StateID" />
                        <input type="hidden" id="CID" asp-for=Landlord.CityID value="@Model.Landlord.CityID" />
                        <input type="hidden" id="OID" asp-for=Property.OwnerId value="@Model.Property.OwnerId" />
                        <input type="hidden" asp-for=Property.CityID value="@Model.Property.CityID" />
                        <input type="hidden" asp-for=Property.StateID value="@Model.Property.StateID" />
                        <div id="smartwizard">
                            <ul class="nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-1">
                                        <span class="num">1</span>
                                        Property Address
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-2">
                                        <span class="num">2</span>
                                        Details
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-3">
                                        <span class="num">3</span>
                                        Features
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-4">
                                        <span class="num">4</span>
                                        Acceptings
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-5">
                                        <span class="num">5</span>
                                        Photos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-6">
                                        <span class="num">6</span>
                                        Inspection Times
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-7">
                                        <span class="num">7</span>
                                        Your Details
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div id="step-1" class="tab-pane" role="tabpanel" aria-labelledby="step-1">
                                    <h3 class="text-center">
                                        Property <span class="text-primary"> Address</span>
                                    </h3>
                                    @if (User.IsInRole(WebSiteRoles.Role_Admin))
                                    {
                                        <div class="row">
                                            <div class="col-xl-6">
                                                <select asp-for="Landlord.Id" asp-items="Model.Landlords" class="nice-select form-control">
                                                    <option selected="selected" disabled>--Select Landlord--</option>
                                                </select>
                                            </div>
                                        </div>
                                    }
                                    <div class="row">                                         
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Street Number or Name*
                                                </label>
                                                <div class="flex">
                                                    <input asp-for="Property.Street" class="form-control"
                                                           placeholder="Enter your street number or name" required>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label asp-for="Property.Suburb" class="text-label form-label"></label>
                                                <input type="text" asp-for="Property.Suburb" class="form-control"
                                                       placeholder="Enter your suburb name">
                                            </div>
                                        </div>
                                        @*<div class="col-lg-4 mb-2">
                                        <div class="mb-3">
                                        <label class="text-label form-label">Suburb</label>
                                        <input type="text" name="StreetName" class="form-control"
                                        placeholder="Enter your unit number (optional)" required>
                                        </div>
                                        </div>*@
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    City*
                                                </label>
                                                <select required id="city" asp-for="Property.CityID"
                                                        asp-items="Model.Cities" class="form-control">
                                                    <option value="">--select city--</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">Postal Code</label>
                                                <input type="text" asp-for="Property.PostalCode" class="form-control"
                                                       placeholder="Enter your postal code">
                                            </div>
                                        </div>
                                    </div>
                                    <p id="full-address-recommend" style="display:none;">
                                        <strong>Tip:</strong> this may lead to reduced interest as information
                                        is hidden, so we typically do not recommend using this
                                    </p>
                                </div>
                                <div id="step-2" class="tab-pane" role="tabpanel" aria-labelledby="step-2">
                                    <h3 class="text-center">Property <span class="text-primary">Details</span></h3>
                                    <div class="row">
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">Bedrooms</label>
                                                <div class="input-group mb-3">
                                                    <div class="input-group-text-sign btn"><i class="fa fa-minus"></i></div>
                                                    <input type="text" class="form-control text-center"
                                                           readonly="readonly" name="new-bathrooms"
                                                           id="new-bathrooms" value="0">
                                                    <div class="input-group-text-sign btn"><i class="fa fa-plus"></i></div>
                                                </div>
                                            </div>
                                        </div>                                         
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">Bathrooms</label>
                                                <div class="input-group mb-3">
                                                    <div class="input-group-text-sign btn"><span class="fa fa-minus"></span></div>
                                                    <input type="text" asp-for="Property.Bathroom" class="form-control text-center"
                                                           readonly="readonly" value="0">
                                                    <div class="input-group-text-sign btn"><span class="fa fa-plus"></span></div>
                                                </div>
                                            </div>
                                        </div>                                         
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">Parking(s)</label>
                                                <div class="input-group mb-3">
                                                    <div class="input-group-text-sign btn"><span class="fa fa-minus"></span></div>
                                                    <input type="text" asp-for="Property.TotalParkings" class="form-control text-center" value="0">
                                                    <div class="input-group-text-sign btn"><span class="fa fa-plus"></span></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Parking Type*
                                                </label>
                                                <div class="col-auto flex">
                                                    <select required asp-for="Property.Parkingtype" class="form-control wide mb-3">
                                                        <option selected value="">Please Select Parking Type</option>
                                                        <option value="1">No Parking</option>
                                                        <option value="2">Off-stree</option>
                                                        <option value="3">On-stree</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Available From*
                                                </label>
                                                <div class="col-auto">
                                                    <div class="input-group mb-2">
                                                        <div class="input-group-text fa fa-calendar"></div>
                                                        <input readonly asp-for="Property.AvailableFrom" required type="text" class="form-control datepicker"
                                                               placeholder="select date">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Weekly Rent*
                                                </label>
                                                <div class="col-auto">
                                                    <div class="input-group mb-2">
                                                        <div class="input-group-text">
                                                            <i class="bi bi-currency-dollar nav-icon"></i>
                                                        </div>
                                                        <input required asp-for="Property.Rent" type="text" class="form-control"
                                                               placeholder="Price paid by tenant">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Bond Amount*
                                                </label>
                                                <div class="col-auto">
                                                    <div class="input-group mb-2">
                                                        <div class="input-group-text">
                                                            <i class="fas fa-rupee-sign"></i>
                                                        </div>
                                                        <input asp-for="Property.BondValue" required type="text" class="form-control"
                                                               placeholder="Typically 4 weeks of rent">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <div class="form-check">
                                                    @Html.CheckBoxFor(m =>m.Property.HidePrice, new
                                                    {
                                                        @class="form-check-input",
                                                    })
                                                    <label class="form-check-label">
                                                        Hide price and display "Contact for Price"
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 mb-2">
                                            <div class="mb-3">
                                                <div class="form-check">
                                                    @Html.CheckBoxFor(m =>m.Property.HideAddress,
                                                    new{
                                                         @class="form-check-input",
                                                    })
                                                    <label class="form-check-label">
                                                        Check this box if you wish to hide your address, and display suburb
                                            only

                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        @if (User.IsInRole(WebSiteRoles.Role_Admin))
                                        {
                                            <div class="col-lg-4 mb-2">
                                                <div class="mb-3">
                                                    <div class="form-check">
                                                        @Html.CheckBoxFor(m => m.Property.IsActive)
                                                        <label class="form-check-label">
                                                            Show on sharehouse.pk as advertisement
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-6 mb-2">
                                            <div class="mb-3">
                                                <div class="form-check">
                                                    @Html.RadioButtonFor(m =>m.Property.SharePhone,true, new{
                                                        @class="form-check-input",
                                                        value=true,
                                                    })
                                                    <label class="form-check-label">
                                                        Please give them my phone number and ask them to contact me
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-6 mb-2">
                                            <div class="mb-3">
                                                <div class="form-check">
                                                    @Html.RadioButtonFor(m =>m.Property.SharePhone,false,new{
                                                        @class="form-check-input",
                                                        value=false,
                                                    })
                                                    <label class="form-check-label">
                                                        Please capture their name and number and email me their details
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    Property Category*
                                                </label>
                                                <div class="flex">
                                                    <select required class="form-control wide mb-3"
                                                            asp-for="Property.Propertytype">
                                                        <option selected value="">--select category--</option>
                                                        <option value="1">House</option>
                                                        <option value="2">Room</option>
                                                        <option value="3">Apartment</option>
                                                        <option value="4">Hostel</option>
                                                        <option value="5">Hostel Room</option>
                                                        <option value="6">Shop</option>
                                                        <option value="7">Office</option>
                                                        <option value="8">Luxury Villa</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">Land Size</label>
                                                <div class="col-auto">
                                                    <div class="input-group mb-2">
                                                        <input asp-for="Property.TotalArea" class="form-control"
                                                               placeholder="Land Size">
                                                        <div class="input-group-text">sqm</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <label>
                                        Advertisement Title*
                                        <i class="fa fa-question-circle" aria-hidden="true" rel="popover"
                                           data-placement="top"
                                           data-content="This will appear at the top of your ad and on your search results"
                                           title="" data-original-title=""></i>
                                    </label>
                                    <div class="flex">
                                        <input type="text" asp-for="Property.AdTitle" required class="form-control"
                                               maxlength="80"
                                               placeholder="Eg. Well-furnished property with views and a pool">
                                    </div>
                                    <p class="help-block" style="margin-top: 6px">
                                        <strong>Tip:</strong> Enter a
                                        short line
                                        highlighting the best features of your property in up to 80 characters
                                    </p>
                                    <label>
                                        Description*
                                        <i class="fa fa-question-circle" aria-hidden="true" rel="popover"
                                           data-placement="top"
                                           data-content="This will appear at the top of your ad and on your search results"
                                           title="" data-original-title=""></i>
                                    </label>
                                    <div class="flex">
                                        <textarea class="form-control" asp-for="Property.Description" rows="5"
                                                  placeholder="Please include relevant information about your property.
                                    Try to keep the description simple and avoid duplicating
                                    information captured elsewhere e.g. price, date
                                    available and inspection times."
                                                  required style="height: 66px;">
                                    </textarea>
                                    </div>
                                </div>
                                <div id="step-3" class="tab-pane" role="tabpanel" aria-labelledby="step-3">
                                    <h3 class="text-center">Property <span class="text-primary">Features</span></h3>
                                    <div class="row">
                                        @for (int i = 0; i < @Model.PropertyFeatures.Count(); i++)
                                        {
                                            <div class="col-xl-3 col-md-6">
                                                <div>
                                                    <input type="hidden" asp-for=@Model.PropertyFeatures[i].FeatureID />
                                                    <input type="hidden" asp-for=@Model.PropertyFeatures[i].PropertyID />
                                                    <input type="hidden" asp-for=@Model.PropertyFeatures[i].ID />
                                                </div>
                                                <div class="form-check custom-checkbox mb-3">
                                                    <input type="checkbox" class="form-check-input"
                                                       id=@Model.PropertyFeatures[i].FeatureID
                                                       asp-for=@Model.PropertyFeatures[i].isSelected>
                                                    <label class="form-check-label"
                                                       asp-for=@Model.PropertyFeatures[i].Feature.Title>
                                                        @Model.PropertyFeatures[i].Feature.Title
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div id="step-4" class="tab-pane" role="tabpanel" aria-labelledby="step-4">
                                    <h3 class="text-center">Property <span class="text-primary">Acceptings</span></h3>
                                    <div class="row">
                                        @for (int i = 0; i < @Model.PropertyAcceptings.Count(); i++)
                                        {
                                            <div class="col-xl-3 col-md-6">
                                                <div>
                                                    <input type="hidden" asp-for=@Model.PropertyAcceptings[i].AcceptingID />
                                                    <input type="hidden" asp-for=@Model.PropertyAcceptings[i].PropertyID />
                                                    <input type="hidden" asp-for=@Model.PropertyAcceptings[i].ID />
                                                </div>
                                                <div class="form-check custom-checkbox mb-3">
                                                    <input type="checkbox" class="form-check-input"
                                                       id=@Model.PropertyAcceptings[i].AcceptingID
                                                       asp-for=@Model.PropertyAcceptings[i].isSelected>
                                                    <label class="form-check-label"
                                                       asp-for=@Model.PropertyAcceptings[i].Accepting.Title>
                                                        @Model.PropertyAcceptings[i].Accepting.Title
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div id="step-5" class="tab-pane" role="tabpanel" aria-labelledby="step-5">
                                    <div class="row">
                                        <h3 class="text-center">
                                            Property <span class="text-primary">
                                                Photos
                                            </span>
                                        </h3>
                                    </div>
                                    <div class="row">
                                        <label>Choose Photos *</label>
                                        <div>
                                            <div class="input-group mb-3">
                                                <div class="form-file">
                                                    <input required id="files" multiple type="file" name="files"
                                                           class="form-file-input form-control">
                                                </div>
                                                <span id="upload" class="btn btn-primary">Upload</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="images" class="row">
                                        @foreach (var img in Model.PropertyImages)
                                        {
                                            <div class="col-md-2">
                                                <div class="p-1">
                                                    <img src="@img.ImagePath" style="height:100%; width:95%" alt="" class="img-a img-fluid">
                                                </div>
                                                <div class="p-1">
                                                    <a href="#" id="@img.ID" onclick="DeletePropertyImage(this.id);">
                                                        <i class="far fa-trash-alt"></i> Delete
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="row">
                                        <p class="">
                                            <strong>Tip:</strong> The first image in the list will
                                            automatically be selected as your primary image.
                                            It will appear as the bigger 'hero' picture on your ad when published on
                                            sharehouse.pk. Drag the
                                            images to re-order.
                                        </p>
                                        <p class="">Maximum number of files: <strong>15</strong></p>
                                    </div>
                                </div>
                                <div id="step-6" class="tab-pane" role="tabpanel" aria-labelledby="step-6">
                                    <div class="row">
                                        <h3 class="text-center">
                                            Property Viewing <span class="text-primary">
                                                inspection times
                                            </span>
                                        </h3>
                                    </div>
                                    @*<div class="form-check">                                         
                                        @Html.CheckBoxFor(m =>m.Property.showInspectionTime,
                                        new{
                                        id="chkinspection",
                                        @class="form-check-input",
                                        })
                                        <label class="form-check-label">
                                            Check this box if you wish to specify inspection times
                                        </label>
                                        <p>If you do not wish to specify inspection times, your ad will show inspections as available by appointment only. We recommend you check the box and list dates and times below.</p>
                                    </div>*@
                                    @*<div id="inspection" style="display:none;">*@
                                    <div class="flex" id="inspection" style="display:none;">
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    <strong>Inspection Date</strong>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    <strong>From</strong>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 mb-2">
                                            <div class="mb-3">
                                                <label class="text-label form-label">
                                                    <strong>To</strong>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="inspectiondetail" style="display:none;">
                                        @for (int i = 0; i < @Model.Inspections.Count(); i++)
                                        {
                                            <div class="flex">
                                                <input type="hidden" asp-for="Inspections[i].ID" />
                                                <input type="hidden" asp-for="Inspections[i].PropertyID" />
                                                <div class="col-lg-4 mb-2">
                                                    <div class="mb-3">
                                                        <div class="col-auto">
                                                            <div class="input-group p-2">
                                                                <input type="text" readonly asp-for="Inspections[i].InspectionDate"
                                                                   class="form-control datepicker">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 mb-2">
                                                    <div class="p-2">
                                                        <div class="col-auto">
                                                            <select class="form-control wide" asp-for=Inspections[i].From>
                                                                <option selected="selected" value="">--Select time--</option>
                                                                <option value="6:00 AM">6:00 AM</option>
                                                                <option value="6:15 AM">6:15 AM</option>
                                                                <option value="6:30 AM">6:30 AM</option>
                                                                <option value="6:45 AM">6:45 AM</option>
                                                                <option value="7:00 AM">7:00 AM</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 mb-2">
                                                    <div class="p-2">
                                                        <div class="col-auto">
                                                            <select class="form-control wide" asp-for=Inspections[i].To>
                                                                <option selected="selected" value="">--Select time--</option>
                                                                <option value="6:00 AM">6:00 AM</option>
                                                                <option value="6:15 AM">6:15 AM</option>
                                                                <option value="6:30 AM">6:30 AM</option>
                                                                <option value="6:45 AM">6:45 AM</option>
                                                                <option value="7:00 AM">7:00 AM</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @* </div>*@
                                </div>
                                <div id="step-7" class="tab-pane" role="tabpanel" aria-labelledby="step-7">
                                    <div id="wizard_Payment" class="tab-pane" role="tabpanel">
                                        <div class="row emial-setup">
                                            <h3 class="text-center">
                                                Your <span class="text-primary">
                                                    Details
                                                </span>
                                            </h3>
                                            <p>
                                                <strong>Please note:</strong> your contact details will not be publicly
                                                available. Queries will be forwarded to your email address, but your details will not be
                                                available
                                                to users on public sites.
                                            </p>
                                            <div class="row">
                                                <div class="col-lg-4 mb-2">
                                                    <div class="mb-3">
