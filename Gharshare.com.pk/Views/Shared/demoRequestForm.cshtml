@using Gharshare.Models
@model DemoRequest
@{

}
<div class="ltn__contact-us-area section-bg-1 py-5">
            <div class="container">
                <div class="row mb-5">
                    <div class="col-lg-6 align-self-center ">
                        <div class="about-us-info-wrap">
                            <div class=" ltn__form-widget">
                                <h2 class=" ltn__widget-title-border-2">See SharehousePK in action</h2>
                                <p>
                                    Learn how the SharehousePK can help you self-manage your rental property.
                                    Register below to watch the demo video.
                                </p>
                                <form action="#">
                                    <div class="form-inline">
                                    <input type="text" asp-for="Name" id="dname" class="input-control" placeholder=" Name*">
                                    <span asp-validation-for="Name"></span>
                                    </div>
                                    <div class="form-inline">
                                    <input type="email" asp-for="Email" id="demail" class="input-control" placeholder=" E-Mail*">
                                    <span asp-validation-for="Name"></span>
                                    </div>
                                    <div class="form-inline">
                                    <input type="text" asp-for="Mobile" id="dmobile" class="input-control" placeholder=" Mobile#*">
                                <span asp-validation-for="Name"></span>    
                                </div>
                                    <button type="submit" class="btn theme-btn-1">Watch the Demo</button>
                                </form>
                            </div>
                            <div class="d-flex flex-wrap gap-3 my-3">
                                <div class="bullets">
                                    <img loading="lazy"
                                         src="https://uploads-ssl.webflow.com/627b58c5f197ff6af1d383c0/63800f594a6edec48b52f9ce_pink-check.png"
                                         alt="" class="image-16" width="20">
                                    <div class="text-block-53">No commitment</div>
                                </div>
                                <div class="bullets">
                                    <img loading="lazy"
                                         src="https://uploads-ssl.webflow.com/627b58c5f197ff6af1d383c0/63800f594a6edec48b52f9ce_pink-check.png"
                                         alt="" class="image-16" width="20">
                                    <div class="text-block-53">Completly Free</div>
                                </div>
                                <div class="bullets">
                                    <img loading="lazy"
                                         src="https://uploads-ssl.webflow.com/627b58c5f197ff6af1d383c0/63800f594a6edec48b52f9ce_pink-check.png"
                                         alt="" class="image-16" width="20">
                                    <div class="text-block-53">No credit card required</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5 offset-md-1 align-self-center mt-4 mt-lg-0">
                        <div class="about-us-img-wrap ltn__img-shape-right mt-4 mt-md-0  about-img-left">
                            <img src="~/img/service/11.jpg" alt="Image">
                        </div>
                    </div>
                </div>
            </div>
        </div>

