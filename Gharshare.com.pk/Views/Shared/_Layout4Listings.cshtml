@using Gharshare.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    @*Main & toaster notification CSS*@
    <link href="~/theme/css/style.css" rel="stylesheet">
    <link href="~/theme/css/custom-style.css" rel="stylesheet" />
    <link href="~/theme/vendor/toastr/css/toastr.min.css" rel="stylesheet" />
    @*For image gallery & carosel*@
    <link href="~/theme/vendor/lightgallery/css/lightgallery.min.css" rel="stylesheet">
    <link href="~/theme/vendor/owl-carousel/owl.carousel.css" rel="stylesheet">
    @*End of image gallery & carosel*@
    <!-- FAVICONS -->
    <link rel="shortcut icon" href="~/img/favicon.png" type="image/x-icon" />
    @*Multi-step Wizard*@
    <link href="~/theme/vendor/jquery-smartwizard/dist/css/smart_wizard_arrows.css" rel="stylesheet">
    @*Carousel*@
    <link href="~/theme/vendor/owl-carousel/owl.carousel.css" rel="stylesheet">
    @*Nice select plugin*@
    <link href="~/theme/vendor/jquery-nice-select/css/nice-select.css" rel="stylesheet">
    @*Font awsome*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    @*Bootstrap icons*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" />
    @*jquery datetime picker*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.css" />

</head>
<body>
    <!-- Body main wrapper start -->
    @{
        ApplicationUser user = null;
        string userName = string.Empty;
        string userEmail = string.Empty;
        string name = string.Empty;

        if (_signInManager.IsSignedIn(User))
        {
            user = await _userManager.GetUserAsync(User);
            userName = user.UserName;
            userEmail = user.Email;
            name = user.Name;
            <div><input id="txtUserId" type="hidden" value=@user.Id></div>
        }

    }
    <!--**********************************
           Header start
       ***********************************-->

    <header class="headerWrapper">
        <div class="logoWrapper">
            <div class="leftWrapper">
            </div>
            <a asp-action="index" asp-controller="home" class="logoLink">
                <img src="~/img/logo.png" alt="" width="200">
            </a>
            <div class="rightWrapper">
                <a asp-action="index" asp-controller="home">
                    <i class="fa fa-close" style="font-size:26px"></i>
                </a>
            </div>
        </div>
    </header>
    <!--**********************************
       End Header
    ***********************************-->
    <div class="content-body">
        <div class="ltn__utilize-overlay"></div>
        <partial name="_Notification" />
        <partial name="_Toasternotification" />
        @RenderBody()
    </div>
    <!-- Body main wrapper end -->
    <!--**********************************
            Footer start
        ***********************************-->
    <div class="footer">
        <div class="copyright">
            <p>
                Copyright © Designed &amp; Developed by <a href="http://www.encodingcorner.com/"
                                                           target="_blank">Encoding Corner Pvt(Ltd)</a> 2023
            </p>
        </div>
    </div>
    <!--Basic Modal-->
            <div class="modal fade" id="basicModal">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 id="modalTitle" class="modal-title"></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal">
                            </button>
                        </div>
                        <div class="modal-body"><div id="modalContainer"></div></div>
                        @*<div class="modal-footer">
                        <button type="button" class="btn btn-danger light" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary">Save changes</button>
                        </div>*@
                    </div>
                </div>
            </div>
    <!-- Account Modal -->
    <div class="modal fade" id="AccountModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">  
                    <h5 id="modalTitle" class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                    </button>
                </div>
                <div class="modal-body">
                    <div id="accountSettingsContainer"></div>
                </div>                 
            </div>
        </div>
    </div>     
     
     
    <!--**********************************
        Footer end
    ***********************************-->
    <!-- preloader area start -->
    <div class="preloader d-none" id="preloader">
        <div class="preloader-inner">
            <div class="spinner">
                <div class="dot1"></div>
                <div class="dot2"></div>
            </div>
        </div>
    </div>
    <!-- End preloader area -->
    <!--**********************************
        Scripts
    ***********************************-->
    <!-- jQuery -->
     <!--Jquery datetime picker partial control contains all required jquery scripts-->
    <partial name="_dtpPartial" />
    <!-- Required vendors -->
    <script src="~/theme/vendor/global/global.min.js"></script>
    <script src="~/theme/vendor/jquery-steps/build/jquery.steps.min.js"></script>
    <script src="~/theme/vendor/jquery-validation/jquery.validate.min.js"></script>
    <!-- Form validate init -->
    <script src="~/theme/js/plugins-init/jquery.validate-init.js"></script>

    <!-- Form Steps -->
    <script src="~/theme/vendor/jquery-smartwizard/dist/js/jquery.smartWizard.js"></script>
    <script src="~/theme/vendor/jquery-nice-select/js/jquery.nice-select.min.js"></script>
    <script src="~/theme/js/custom.min.js"></script>
    <script src="~/theme/js/deznav-init.js"></script>
    @*For image gallery carosel*@
    <script src="~/theme/vendor/owl-carousel/owl.carousel.js"></script>
    <script src="~/theme/js/dz.carousel.js"></script>
    <script src="~/theme/vendor/lightgallery/js/lightgallery-all.min.js"></script>
    @*End of image gallery carosel*@

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>

     
    <script>
        function closeListPlace() {
            alert("Are you sure you wish to close? Doing so will delete the listing you are creating.");
        }
    </script>
</body>
</html>