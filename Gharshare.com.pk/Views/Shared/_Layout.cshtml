        $(document).ready(function() {
            $('#advertise,#enquiry,#manage,#tenant,#lease,#setup,#condition,#bond,#rental,#tracking,#tbills,#greport,#organize,#rinspecion,#sdocument').click(function(event) {
                event.preventDefault(); // Prevent the default link behavior
