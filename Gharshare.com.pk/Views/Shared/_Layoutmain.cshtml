                                                                <i class="fa fa-plus iconAdd"></i>
                                                                Create Listing
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                                @if (placelist.Any())
                                                {
                                                    foreach (var place in placelist)
                                                    {
                                                        <div class="mb-3 subtitle-bar listing my-account-create-button">
                                                            <div class="col-md-2">
                                                                @if (place.listingstatus == Property.Status.Active)
                                                                {
                                                                    <div class="status-Active">
                                                                        <div class="status-label">
                                                                            <span>Active</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (place.listingstatus == Property.Status.Pending)
                                                                {
                                                                    <div class="status-pending">
                                                                        <div class="status-label">
                                                                            <span>Pending</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (place.listingstatus == Property.Status.Draft)
                                                                {
                                                                    <div class="status-draft">
                                                                        <div class="status-label">
                                                                            <span>Draft</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (place.listingstatus == Property.Status.Inactive)
                                                                {
                                                                    <div class="status-inactive">
                                                                        <div class="status-label">
                                                                            <span>Inactive</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (place.listingstatus == Property.Status.blocked)
                                                                {
                                                                    <div class="status-blocked">
                                                                        <div class="status-label">
                                                                            <span>Bloked</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (place.listingstatus == Property.Status.expired)
                                                                {
                                                                    <div class="status-expired">
                                                                        <div class="status-label">
                                                                            <span>Plan Expired</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="col-md-8">
                                                                <a asp-action="listplacepreview" asp-controller="listing" title="@place.Address"
                                                                   asp-route-propertyId="@place.UId">
                                                                    <p style="color: #ffffff;margin-left:25px;text-align:left;">
                                                                        @if (place.Address != "" & place.Address != null)
                                                                        {
                                                                            @Utility.shortText(place.Address, 25)
                                                                        }
                                                                    </p>
                                                                </a>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <a asp-action="listplacepreview" asp-controller="listing"
                                                                   asp-route-propertyId="@place.UId" asp-route-preview=false>
                                                                    <i class="fa fa-pencil"></i>
                                                                    <span>Edit</span>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="subtitle-bar listing my-account-create-button">
                                                        <p style="color: #ffffff;"> You don’t have any property listing</p>
                                                        <div class="my-account-create-button">
                                                            <button type="button" onclick="location.href='@Url.Action("listplace", "listing")'" class="btn-listing">
                                                                <i class="fa fa-plus iconAdd"></i><span class="createButtonText"> Create listing</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                                <hr>
                                                <div class="subtitle-bar mb-2">
                                                    <h6 style="color: #ffffff;">
                                                        <i class="fa-solid fa-user"></i> Looking
                                                        for a place
                                                    </h6>
                                                    @if (personListings.Count() == 0)
                                                    {
                                                        <div class="my-account-create-button">
                                                            <button type="button" onclick="location.href='@Url.Action("findplace", "findplace")'"
                                                                    class="btn-listing">
                                                                <i class="fa fa-plus iconAdd"></i>
                                                                <span class="createButtonText">
                                                                    Create Listing
                                                                </span>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                                @if (personListings.Any())
                                                {
                                                    foreach (var personlisting in personListings)
                                                    {
                                                        <div class="mb-3 subtitle-bar listing my-account-create-button">
                                                            <div class="col-md-2">
                                                                @if (personlisting.listingstatus == PersonListing.Status.Active)
                                                                {
                                                                    <div class="status-Active">
                                                                        <div class="status-label">
                                                                            <span>Active</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (personlisting.listingstatus == PersonListing.Status.Pending)
                                                                {
                                                                    <div class="status-pending">
                                                                        <div class="status-label">
                                                                            <span>Pending</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (personlisting.listingstatus == PersonListing.Status.Draft)
                                                                {
                                                                    <div class="status-draft">
                                                                        <div class="status-label">
                                                                            <span>Draft</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (personlisting.listingstatus == PersonListing.Status.Inactive)
                                                                {
                                                                    <div class="status-inactive">
                                                                        <div class="status-label">
                                                                            <span>Inactive</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (personlisting.listingstatus == PersonListing.Status.blocked)
                                                                {
                                                                    <div class="status-blocked">
                                                                        <div class="status-label">
                                                                            <span>Blocked</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (personlisting.listingstatus == PersonListing.Status.expired)
                                                                {
                                                                    <div class="status-expired">
                                                                        <div class="status-label">
                                                                            <span>Plan expired</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="col-md-8">
                                                                <a asp-action="findplacepreview" asp-controller="findplace" title="@personlisting.Suburb"
                                                                   asp-route-listingId="@personlisting.ID">
                                                                    <p style="color: #ffffff;margin-left:25px;text-align:left;">
                                                                        @if (!string.IsNullOrEmpty(personlisting.Suburb) && personlisting.Suburb.Length > 9)
                                                                        {
                                                                            <span>Need accommodation in</span>
                                                                            Utility.shortText(@personlisting.Suburb, 9);
                                                                            <span>....</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>Need accommodation in</span> @personlisting.Suburb
                                                                        }
                                                                    </p>
                                                                </a>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <a asp-action="findplacepreview" asp-controller="findplace"
                                                                   asp-route-listingId="@personlisting.UId">
                                                                    <i class="fa fa-pencil"></i>
                                                                    <span>Edit</span>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="subtitle-bar listing my-account-create-button">
                                                        <p style="color: #ffffff;"> You don’t have any person listing</p>
                                                        @*<div class="subtitle-bar listing my-account-create-button">*@
                                                        <div class="my-account-create-button">
                                                            <button type="button" onclick="location.href='@Url.Action("findplace", "findplace")'"
                                                                    class="btn-listing">
                                                                <i class="fa fa-plus iconAdd"></i>
                                                                <span class="createButtonText">
                                                                    Create listing
                                                                </span>
                                                            </button>
                                                        </div>
                                                        @*</div>*@
                                                    </div>
                                                }
                                                @if (!(placelist.Count() > 0) && !(personListings.Count() > 0) && _signInManager.IsSignedIn(User))
