<body>
    @{
        ApplicationUser user = null;
        ApplicationUser defaultAdmin = _unitOfWork.User.Get(u => u.UserType == ApplicationUser.usertype.superadmin
        && u.DefaultAdmin == true);
        string defaultAdminId = defaultAdmin.Id;
        string userName = string.Empty;
        string userEmail = string.Empty;
        string name = string.Empty;
        List<Property> placelist = new List<Property>();
        List<PersonListing> personListings = new List<PersonListing>();
        UserPlan userPlan = null;
        List<PlanService> planServices = new List<PlanService>();
        Int16 allowedPropertylistings = 100; // set it back to 1 when subscription enabaled
        //List<City> featureCities = new List<City>();
        Sitesetting sitesettings = _unitOfWork.Sitesetting.Get(s => s.ID > 0);
        var featureCities = _unitOfWork.City.GetAll(c => c.Featured == true).ToList().OrderBy(c => c.Shortname);
        TempData["error"] = Context.Items["Error"] as string;

        if (_signInManager.IsSignedIn(User))
        {
            user = await _userManager.GetUserAsync(User);
            userName = user.UserName;
            userEmail = user.Email;
            name = user.Name;

            var session = HttpContextAccessor.HttpContext.Session;
            session.SetString("_UserId", user.Id);
            //session.SetString("_UserType", user.UserType);
            if (userEmail == string.Empty || userEmail == null)
                userEmail ="NA";
            session.SetString("ownerEmail", userEmail);
            placelist = _unitOfWork.Property.GetAll(p => p.OwnerId == user.Id
            ).ToList();
            personListings = _unitOfWork.PersonListing.GetAll(p => p.UserId == user.Id
            ).ToList();
            session.SetString("personListingcount", personListings.Count().ToString());
            session.SetString("propertyListingcount", placelist.Count().ToString());

            userPlan = _unitOfWork.UserPlan.Get(p => p.UserId == user.Id
            && p.Status == UserPlan.status.Active, includeProperties: "Plan");

            if (userPlan != null)
            {
                planServices = _unitOfWork.PlanService.GetAll(ps => ps.PlanID == userPlan.PlanId).ToList();

                var livePropertylistingservice = planServices.SingleOrDefault(ps => ps.livepropertylisting != null);
                allowedPropertylistings = livePropertylistingservice.livepropertylisting.HasValue
                ? (Int16)livePropertylistingservice.livepropertylisting : (Int16)0;

                session.SetString("allowedPropertylistings", allowedPropertylistings.ToString());

            }
        }
    }
    <!-- Body main wrapper start -->
