@using Gharshare.Models
@using Gharshare.CommonHelper
@model PlanserviceVM
@{
    ViewData["Title"] = "Upgrade account by subscribing a plan";
    Layout = "_Layout4Listings";
}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-sm-6">
            <h4 class="text-center">
                I am looking for a
            </h4>
            <div class="mb-4">
                <div class="card-action coin-tabs review-tabs-1">
                    <ul class="nav nav-tabs justify-content-center" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#Flatmate" role="tab" aria-selected="true">Flatmate</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#Room" role="tab" aria-selected="false">Room</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-content">
        <div class="tab-pane fade active show" id="Flatmate">
            <div class="col-xl-12">
                <div class="container p-5">
                    <div class="row">
                        <div class="text-center">
                            <h2>Upgrade now to find a flatmate faster</h2>
                            <p>Don't miss out on your dream flatmate. Upgrade now</p>
                        </div>
                    </div>
                    <div class="row">
                        <div style="width:20%;" class="col-md-12 mb-4"></div>
                        @if (Model.Landlordplans.Any())
                        {
                            foreach (var landlordplan in Model.Landlordplans)
                            {
                                <div style="width:20%;" class="col-md-12 mb-4">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="text-center">
                                                <h5 class="card-title text-primary">@landlordplan.Title</h5>
                                                <h2>Rs. <span>@Utility.Format(landlordplan.Price)</span></h2>

                                                <strong>@landlordplan.Tagline</strong>

                                                <p class="card-text">
                                                    @Utility.shortText(landlordplan.Description,90)
                                                </p>
                                                @{
                                                    var userPlan = Model.userPlans.SingleOrDefault(p => p.PlanId == landlordplan.ID
                                                    && p.UserId == Model.userId && p.Status == UserPlan.status.Active);
                                                    if (userPlan != null)
                                                    {
                                                        if (userPlan.PlanId == landlordplan.ID)
                                                        {
                                                            <button disabled class="btn btn-outline-primary btn-md w-100">Current Plan</button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (landlordplan.PlanType == Plan.Plantype.forboth)
                                                        {
                                                            <button disabled class="btn btn-outline-primary btn-md w-100">Free Plan</button>
                                                        }
                                                        else
                                                        {
                                                            <a data-planid="@landlordplan.ID" class="subscribe btn btn-primary btn-md w-100"
                                               data-bs-toggle="modal" data-bs-target="#AccountModal">
                                                                Get @landlordplan.Title
                                                            </a>
                                                        }
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
